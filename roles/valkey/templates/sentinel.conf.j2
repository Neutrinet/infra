{{ ansible_managed | comment }}

include /etc/valkey/sentinel-neutrinet-static.conf

{% if 'ipv6' in valkey_members[0] %}
sentinel monitor neutrinet {{ valkey_members[0].ipv6 }} 6379 2
{% endif %}
{% if 'ipv4' in valkey_members[0] %}
sentinel monitor neutrinet {{ valkey_members[0].ipv4 }} 6379 2
{% endif %}
