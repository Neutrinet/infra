{{ ansible_managed | comment }}

scope: "{{ postgresql_major_version }}-{{ postgresql_patroni_name }}"
name: "{{ inventory_hostname }}"

restapi:
  listen: "[::]:8008"
  connect_address: "[{{ patroni_current_member.ipv6 }}]:8008"
  allowlist:
    - "::1"
  allowlist_include_members: true

etcd3:
  host: "[::1]:2379"
  protocol: http

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    primary_start_timeout: 300
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        max_connections: 300
        wal_keep_size: 1600MB

  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: "[::1,{{ patroni_current_member.ipv6 }}]:5432"
  connect_address: "[{{ patroni_current_member.ipv6 }}]:5432"
  use_unix_socket: true
  data_dir: /media/data/postgresql/{{ postgresql_major_version }}/{{ postgresql_patroni_name }}
  bin_dir: /usr/lib/postgresql/{{ postgresql_major_version }}/bin
  pgpass: /media/data/postgresql/{{ postgresql_major_version }}-{{ postgresql_patroni_name }}.pgpass

  authentication:
    replication:
      username: {{ postgresql_patroni_replication_username | string | to_json }}
      password: {{ postgresql_patroni_replication_password | string | to_json }}
    superuser:
      username: postgres
    rewind:
      username: {{ postgresql_patroni_rewind_username | string | to_json }}
      password: {{ postgresql_patroni_rewind_password | string | to_json }}

  pg_hba:
    - local all         all                     peer
    - host  all         all        ::1/128      scram-sha-256
    - local replication all                     peer
    - host  replication all        ::1/128      scram-sha-256
{% for client in postgresql_patroni_clients %}
    - host  all         all        {{ client }} scram-sha-256
{% endfor %}
{% for member in etcd_members %}
    - host  replication {{ postgresql_patroni_replication_username }} {{ member.ipv6 }}/128 scram-sha-256
    - host  all         {{ postgresql_patroni_replication_username }} {{ member.ipv6 }}/128 scram-sha-256
    - host  all         {{ postgresql_patroni_rewind_username }}     {{ member.ipv6 }}/128 scram-sha-256
{% endfor %}

  parameters:
    shared_buffers: {{ postgresql_patroni_shared_buffers }}
    effective_cache_size: {{ postgresql_patroni_effective_cache_size }}
    work_mem: {{ postgresql_patroni_work_mem }}
    maintenance_work_mem: {{ postgresql_patroni_maintenance_work_mem }}
    random_page_cost: 1.1
    effective_io_concurrency: 100
    jit: "off"
    max_slot_wal_keep_size: 10GB
    shared_preload_libraries: pg_stat_statements
    log_min_duration_statement: 500ms
    track_io_timing: "on"
    unix_socket_directories: /var/run/postgresql/
    logging_collector: 'on'
    log_directory: /var/log/postgresql
    log_filename: "postgresql-{{ postgresql_major_version }}-{{ postgresql_patroni_name }}.log"
