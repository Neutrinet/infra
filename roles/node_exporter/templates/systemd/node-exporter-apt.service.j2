{{ ansible_managed | comment }}

[Unit]
Description=Collect apt metrics for node-exporter

[Service]
Type=oneshot
User=node-exporter
Group=node-exporter
Environment=TMPDIR=/var/lib/node-exporter/textfile_collector
ExecStart=/bin/bash -o pipefail -c "/usr/local/libexec/node-exporter/apt_info.py | sponge /var/lib/node-exporter/textfile_collector/apt.prom"

# Systemd hardening
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node-exporter/textfile_collector
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
