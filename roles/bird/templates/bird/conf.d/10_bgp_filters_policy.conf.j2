function match_rtbh_v4(string direction; string locality; int AS) -> bool
{
	if direction = "import" then {
		if (bgp_community ~ [(65535, 666)]) then {
			if (net.len = 32) then {
				dest = RTD_BLACKHOLE;
				bgp_local_pref = 900;

				print "[", direction, "][", locality, "] RTBH: Add to blackhole: ", net, " ", bgp_path;
				return true;
			} else {
				print "[", direction, "][", locality, "] Reject: Invalid mask to blackhole: ", net, " ", bgp_path;
				bgp_community.delete((65535, 666));
				return false;
			}
		}
	}

	if direction = "export" && (bgp_community ~ [(65535, 666)]) then {
		bgp_community.delete((65535, 666));

		case AS {
			6696: { bgp_community.add((6696, 666)); bgp_community.add((65535, 65281)); }
			35137: bgp_community.add((65535, 666));
			34307: bgp_community.add((65535, 666));
			5406: bgp_community.add((5406, 666));
			24785: { bgp_community.add((24785, 666)); bgp_community.add((65535, 65281)); }
			20562: { bgp_community.add((20562, 666)); bgp_community.add((65535, 65281)); }
			else: return false;
		}

		return true;
	}

	return false;
}

