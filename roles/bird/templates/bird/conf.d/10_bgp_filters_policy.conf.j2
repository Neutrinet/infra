function bgp_import_client_to_access(int AS; prefix set irr_v4; prefix set irr_v6; bool static_prefixes) -> bool
bool rtbh;
{
	bgp_large_community.delete([(my_asn, *, *)]);

	if reject_tier1_asns("import", "client") then return false;
	if net.type = NET_IP4 then {
		rtbh = match_rtbh_v4("import", "client", AS);
		if (net !~ irr_v4) then return false;
		if !rtbh && static_prefixes && bgp_import_reject_static_client_v4("client") then return false;
		if !rtbh && !static_prefixes && bgp_import_reject_v4("client") then return false;
	}
	if net.type = NET_IP6 then {
		rtbh = match_rtbh_v6("import", "client", AS);
		if (net !~ irr_v6) then return false;
		if !rtbh && static_prefixes && bgp_import_reject_static_client_v6("client") then return false;
		if !rtbh && !static_prefixes && bgp_import_reject_v6("client") then return false;
	}

	bgp_large_community.add((my_asn, AS, bgp_community_calcul("internal", "internal")));
	if AS = my_asn then bgp_large_community.add((my_asn, 0, 40));
	else bgp_large_community.add((my_asn, 0, 30));

	if !rtbh then bgp_local_pref = bgp_local_pref_calcul("client");
	if !rtbh then bgp_apply_graceful_shutdown();

	return true;
}

function bgp_export_access_to_client(int AS) -> bool
{
	if (source != RTS_BGP) then return false;
	if net.type = NET_IP4 then {
		if (net = 0.0.0.0/0) then return true;
	}
	if net.type = NET_IP6 then {
		if (net = ::/0) then return true;
	}
	return false;
}

function bgp_export_own_network_direct(int AS) -> bool
{
	if (proto = "direct1") then {
		if (net.type = NET_IP4 && net ~ NEUTRINET_PREFIXES_V4) then {
			bgp_large_community.add((my_asn, 0, 40));
			bgp_local_pref = 190;
			return true;
		}
		if (net.type = NET_IP6 && net ~ NEUTRINET_PREFIXES_V6) then {
			bgp_large_community.add((my_asn, 0, 40));
			bgp_local_pref = 190;
			return true;
		}
	}
	return false;
}

function bgp_import_core_to_border(int AS) -> bool
{
	if bgp_is_bogon_blackhole() then return true;
	if (bgp_community ~ [(65535, 666)]) then {
		dest = RTD_BLACKHOLE;
		bgp_local_pref = 900;
	}
	if bgp_learned_by_client() then return true;
	if bgp_is_own_network() then return true;
	if (bgp_community ~ [(65535, 666)]) then return true;
	return false;
}

function bgp_import_core_to_access(int AS) -> bool
{
	if bgp_is_bogon_blackhole() then return true;
	if net.type = NET_IP4 then { if (net ~ [0.0.0.0/0]) then return true; }
	if net.type = NET_IP6 then { if (net ~ [::/0]) then return true; }
	return false;
}

function bgp_export_border_to_core(int AS) -> bool
{
	if (proto = "direct1") then {
		bgp_export_own_network_direct(AS);
	}
	if bgp_learned_by_ebgp() then return true;
	if bgp_learned_by_client() then return true;
	if bgp_is_own_network() then return true;
	return false;
}

