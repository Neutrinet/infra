function bgp_export_core_to_tools(int AS) -> bool
{
	if bgp_learned_by_ebgp() then return true;
	if !bgp_learned_by_client() then return false;
	if (bgp_community ~ [(65535, 666)]) then return false;
	if net.type = NET_IP4 && bgp_export_reject_v4("tools") then return false;
	if net.type = NET_IP6 && bgp_export_reject_v6("tools") then return false;
	bgp_large_community.delete([(my_asn, 0, *)]);
	return true;
}

function bgp_import_bogons_to_core(int AS) -> bool
{
	if !((65332, 888) ~ bgp_community) then return false;
	if net.len = 0 then return false;
	if net.type = NET_IP4 && net ~ NEUTRINET_PREFIXES_V4 then return false;
	if net.type = NET_IP6 && net ~ NEUTRINET_PREFIXES_V6 then return false;
	if net.type = NET_IP4 && net ~ [23.128.97.0/24+] then return false;
	if net.type = NET_IP6 && net ~ [2607:7c80:53::/48+] then return false;

	bgp_large_community.delete([(my_asn, *, *)]);
	bgp_community.delete((65535, 666));
	bgp_large_community.add((my_asn, 0, 60));
	bgp_local_pref = 500;
	dest = RTD_BLACKHOLE;

	return true;
}
