function bgp_export_border_to_route_server(int AS) -> bool
bool rtbh;
{
	if bgp_learned_by_ebgp() then return false;
	if !bgp_learned_by_client() && !bgp_is_own_network() && !(bgp_community ~ [(65535, 666)]) then return false;

	if net.type = NET_IP4 then {
		rtbh = match_rtbh_v4("export", "route-server", AS);
		if rtbh then bgp_path.delete(PRIVATE_ASNS);
		if rtbh && (reject_bogon_asns("export", "route-server") || reject_v4_bogon_prefixes("export", "route-server")) then return false;
		if !rtbh && bgp_export_reject_v4("route-server") then return false;
	}
	if net.type = NET_IP6 then {
		rtbh = match_rtbh_v6("export", "route-server", AS);
		if rtbh then bgp_path.delete(PRIVATE_ASNS);
		if rtbh && (reject_bogon_asns("export", "route-server") || reject_v6_bogon_prefixes("export", "route-server")) then return false;
		if !rtbh && bgp_export_reject_v6("route-server") then return false;
	}

	if (bgp_large_community ~ [(my_asn, 398987, *)]) then {
		bgp_community.add((0, 6939));
	}

{% if bird_ixp_locality is defined %}
	bgp_large_community.add((my_asn, AS, bgp_community_calcul("route-server", "{{ bird_ixp_locality }}")));
{% endif %}
	bgp_large_community.delete([(my_asn, 0, *)]);
{% if bird_transit_asns is defined %}
{% for transit_asn in bird_transit_asns %}
	bgp_large_community.add((AS, 0, {{ transit_asn }}));
{% endfor %}
{% endif %}

	return true;
}

function bgp_import_peering_to_border(int AS; prefix set irr_v4; prefix set irr_v6) -> bool
{
	bgp_large_community.delete([(my_asn, *, *)]);
	bgp_community.delete((65535, 666));

	if (bgp_next_hop != from) then {
		print "[import][peering] Reject: next hop is not the neighbor: ", net, " ", bgp_next_hop, " ", from;
		return false;
	}
	if net.type = NET_IP4 then {
		if bgp_import_reject_v4("peering") then return false;
		if (net !~ irr_v4) then return false;
	}
	if net.type = NET_IP6 then {
		if bgp_import_reject_v6("peering") then return false;
		if (net !~ irr_v6) then return false;
	}
	if reject_tier1_asns("import", "peering") then return false;

{% if bird_ixp_locality is defined %}
	bgp_large_community.add((my_asn, AS, bgp_community_calcul("peering", "{{ bird_ixp_locality }}")));
{% endif %}
	bgp_local_pref = bgp_local_pref_calcul("peering");
	bgp_apply_graceful_shutdown();

	bgp_large_community.add((my_asn, 0, 20));

	return true;
}

