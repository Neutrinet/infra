function bgp_community_calcul(string type_filter; string locality) -> int
int community;
{
	if ! (type_filter = "internal" || type_filter = "transit" || type_filter = "route-server" || type_filter = "peering") then {
		print "bgp_community_calcul: parametre type_filter invalide: ", type_filter;
		return 0;
	}

	if ! (locality = "internal" || locality = "private" || locality = "belgiumix" || locality = "bnix" || locality = "nlix") then {
		print "bgp_community_calcul: parametre locality invalide: ", locality;
		return 0;
	}

	community = 0;

	if locality = "internal"        then community = community + 1000;
	if locality = "private"         then community = community + 2000;
	if locality = "belgiumix"       then community = community + 3000;
	if locality = "bnix"            then community = community + 3100;
	if locality = "nlix"            then community = community + 3200;

	if type_filter = "internal"     then community = community + 10;
	if type_filter = "transit"      then community = community + 20;
	if type_filter = "route-server" then community = community + 30;
	if type_filter = "peering"      then community = community + 31;

	return community;
}

function bgp_local_pref_calcul(string type_filter) -> int
int local_pref;
{
	local_pref = 190;

	if type_filter = "transit"      then local_pref = 100;
	if type_filter = "route-server" then local_pref = 110;
	if type_filter = "peering"      then local_pref = 120;

	return local_pref;
}

function bgp_apply_graceful_shutdown()
{
	if ((65535, 0) ~ bgp_community) then bgp_local_pref = 0;
}

function bgp_learned_by_ebgp() -> bool
{
	return bgp_large_community ~ [(my_asn, 0, 20)];
}

function bgp_learned_by_client() -> bool
{
	return bgp_large_community ~ [(my_asn, 0, 30)];
}

function bgp_is_own_network() -> bool
{
	return bgp_large_community ~ [(my_asn, 0, 40)];
}

function bgp_is_bogon_blackhole() -> bool
{
	return bgp_large_community ~ [(my_asn, 0, 60)];
}

function bgp_import_transit_to_border(int AS; int local_pref) -> bool
{
	bgp_large_community.delete([(my_asn, *, *)]);
	bgp_community.delete((65535, 666));

	if net.type = NET_IP4 && bgp_import_reject_v4("transit") then return false;
	if net.type = NET_IP6 && bgp_import_reject_v6("transit") then return false;

{% if bird_ixp_locality is defined %}
	bgp_large_community.add((my_asn, AS, bgp_community_calcul("transit", "{{ bird_ixp_locality }}")));
{% endif %}
	bgp_local_pref = bgp_local_pref_calcul("transit");
	if local_pref > 0 then bgp_local_pref = local_pref;
	bgp_apply_graceful_shutdown();

	bgp_large_community.add((my_asn, 0, 20));

	return true;
}

function bgp_export_border_to_transit(int AS; int prepend_count) -> bool
bool rtbh;
{
	if bgp_learned_by_ebgp() then return false;
	if !bgp_learned_by_client() && !bgp_is_own_network() && !(bgp_community ~ [(65535, 666)]) then return false;

	if net.type = NET_IP4 then {
		rtbh = match_rtbh_v4("export", "transit", AS);
		if rtbh then bgp_path.delete(PRIVATE_ASNS);
		if rtbh && (reject_bogon_asns("export", "transit") || reject_v4_bogon_prefixes("export", "transit")) then return false;
		if !rtbh && bgp_export_reject_v4("transit") then return false;
	}
	if net.type = NET_IP6 then {
		rtbh = match_rtbh_v6("export", "transit", AS);
		if rtbh then bgp_path.delete(PRIVATE_ASNS);
		if rtbh && (reject_bogon_asns("export", "transit") || reject_v6_bogon_prefixes("export", "transit")) then return false;
		if !rtbh && bgp_export_reject_v6("transit") then return false;
	}

{% if bird_ixp_locality is defined %}
	bgp_large_community.add((my_asn, AS, bgp_community_calcul("transit", "{{ bird_ixp_locality }}")));
{% endif %}
	bgp_large_community.delete([(my_asn, 0, *)]);

	if bgp_path.len = 0 then {
		if prepend_count >= 1 then bgp_path.prepend(my_asn);
		if prepend_count >= 2 then bgp_path.prepend(my_asn);
		if prepend_count >= 3 then bgp_path.prepend(my_asn);
	}

	return true;
}

