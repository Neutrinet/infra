function reject_too_many_communities(string direction; string locality) -> bool
{
	if (bgp_community.len + bgp_ext_community.len + bgp_large_community.len > 100) then {
		print "[", direction, "][", locality, "] Reject: Too many communities: ", net, " ", bgp_path;
		return true;
	}
	return false;
}

