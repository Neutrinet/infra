function reject_v4_invalid_rpki(string direction; string locality) -> bool
{
	if bgp_path.len = 0 then {
		if direction = "import" then return false;
		if roa_check(roa_v4, net, my_asn) = ROA_INVALID then {
			print "[", direction, "][", locality, "] Reject: Invalid RPKI for our own origin: ", net;
			return true;
		}
		return false;
	}

	if roa_check(roa_v4, net, bgp_path.last_nonaggregated) = ROA_INVALID then {
		print "[", direction, "][", locality, "] Reject: Invalid RPKI: ", net, " ", bgp_path;
		return true;
	}
	return false;
}

