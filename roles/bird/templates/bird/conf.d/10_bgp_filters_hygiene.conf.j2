function reject_v6_invalid_rpki(string direction; string locality) -> bool
{
	if bgp_path.len = 0 then {
		if direction = "import" then return false;
		if roa_check(roa_v6, net, my_asn) = ROA_INVALID then {
			print "[", direction, "][", locality, "] Reject: Invalid RPKI for our own origin: ", net;
			return true;
		}
		return false;
	}

	if roa_check(roa_v6, net, bgp_path.last_nonaggregated) = ROA_INVALID then {
		print "[", direction, "][", locality, "] Reject: Invalid RPKI: ", net, " ", bgp_path;
		return true;
	}
	return false;
}

function reject_invalid_aspa(string direction; string locality) -> bool
{
	if bgp_path.len = 0 then return false;

	if locality = "transit" then {
		if (aspa_check_downstream(aspa_t) = ASPA_INVALID) then {
			print "[", direction, "][", locality, "] Reject: Invalid ASPA: ", net, " ", bgp_path;
			return true;
		}
	}
	else if (locality = "peering" || locality = "route-server" || locality = "client") then {
		if (aspa_check_upstream(aspa_t) = ASPA_INVALID) then {
			print "[", direction, "][", locality, "] Reject: Invalid ASPA: ", net, " ", bgp_path;
			return true;
		}
	}

	return false;
}

function bgp_import_reject_v4(string type_filter) -> bool
{
	if reject_bogon_asns("import", type_filter)          then return true;
	if reject_long_aspaths("import", type_filter)         then return true;
	if reject_too_many_communities("import", type_filter) then return true;
	if reject_v4_default_route("import", type_filter)     then return true;
	if reject_v4_short_prefixes("import", type_filter)    then return true;
	if reject_v4_bogon_prefixes("import", type_filter)    then return true;
	if reject_v4_ixp_lan_prefixes("import", type_filter)  then return true;
	if reject_v4_own_prefixes("import", type_filter)      then return true;
	if reject_v4_small_prefixes("import", type_filter)    then return true;
	if reject_v4_invalid_rpki("import", type_filter)      then return true;
	if reject_invalid_aspa("import", type_filter)         then return true;
	return false;
}

function bgp_import_reject_v6(string type_filter) -> bool
{
	if reject_bogon_asns("import", type_filter)          then return true;
	if reject_long_aspaths("import", type_filter)         then return true;
	if reject_too_many_communities("import", type_filter) then return true;
	if reject_v6_default_route("import", type_filter)     then return true;
	if reject_v6_short_prefixes("import", type_filter)    then return true;
	if reject_v6_not_global_unicast("import", type_filter) then return true;
	if reject_v6_bogon_prefixes("import", type_filter)    then return true;
	if reject_v6_ixp_lan_prefixes("import", type_filter)  then return true;
	if reject_v6_own_prefixes("import", type_filter)      then return true;
	if reject_v6_small_prefixes("import", type_filter)    then return true;
	if reject_v6_invalid_rpki("import", type_filter)      then return true;
	if reject_invalid_aspa("import", type_filter)         then return true;
	return false;
}

function bgp_import_reject_static_client_v4(string type_filter) -> bool
{
	if reject_long_aspaths("import", type_filter)         then return true;
	if reject_too_many_communities("import", type_filter) then return true;
	if reject_v4_default_route("import", type_filter)     then return true;
	if !(bgp_path.last_nonaggregated ~ PRIVATE_ASNS) && reject_v4_invalid_rpki("import", type_filter) then return true;
	if reject_invalid_aspa("import", type_filter)         then return true;
	return false;
}

function bgp_import_reject_static_client_v6(string type_filter) -> bool
{
	if reject_long_aspaths("import", type_filter)         then return true;
