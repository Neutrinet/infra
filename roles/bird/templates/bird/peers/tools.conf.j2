{{ ansible_managed | comment }}
{% for item in peer_group[1] %}
protocol bgp tools_{{ item.slug }}_v6 from bgp_std {
	neighbor {{ item.neighbor_ipv6 }} as {{ item.asn }};
{% if item.multihop | default(false) %}
	multihop;
{% endif %}
{% if 'neighbor_ipv6_interface' in item %}
	interface "{{ item.neighbor_ipv6_interface }}";
	direct;
{% endif %}
{% if 'neighbor_ipv6_password' in item %}
	password "{{ item.neighbor_ipv6_password }}";
{% endif %}
{% if item.passive | default(false) %}
	passive on;
{% endif %}
	description "[tools] {{ item.name }} ({{ item.asn }})";

	ipv4 {
		import none;
		export where bgp_export_core_to_tools({{ item.asn }});
		add paths on;
		extended next hop on;
	};
	ipv6 {
		import none;
		export where bgp_export_core_to_tools({{ item.asn }});
		add paths on;
	};
}
{%- endfor %}
