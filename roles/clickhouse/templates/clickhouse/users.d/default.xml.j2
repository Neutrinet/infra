{{ ansible_managed | comment('xml') }}

<clickhouse>
    <users>
        <default>
            <password remove="remove" />
            <password_sha256_hex>{{ clickhouse_default_password | hash('sha256') }}</password_sha256_hex>
            <networks replace="replace">
                <ip>::1</ip>
            </networks>
        </default>
    </users>
</clickhouse>
