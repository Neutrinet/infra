{{ ansible_managed | comment }}

global
    maxconn 20480

    log /dev/log	local0
    log /dev/log	local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # https://stackoverflow.com/a/64119235
    noreuseport

    # Empreinte JA4 du ClientHello TLS (2048 pour les ClientHello post-quantiques)
    tune.ssl.capture-buffer-size 2048
    tune.lua.bool-sample-conversion normal
    lua-load /etc/haproxy/lua/ja4.lua

    # generated 2026-10-14, TLSRef Guideline v6.0, HAProxy 3.2.25-1~bpo13+1, OpenSSL 3.5.7, intermediate config, HSTS, gitrev=6bcb595
    # https://configurator.tlsref.org/#server=haproxy&version=3.2.25-1~bpo13+1&config=intermediate&openssl=3.5.7&hsts&guideline=6.0
    # intermediate configuration
    ssl-default-bind-curves X25519MLKEM768:X25519:prime256v1:secp384r1
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options prefer-client-ciphers ssl-min-ver TLSv1.2 no-tls-tickets

    ssl-default-server-curves X25519MLKEM768:X25519:prime256v1:secp384r1
    ssl-default-server-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    ssl-default-server-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-server-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log	global
    mode	http
    option	dontlognull
    option	httplog
    timeout connect 10s
    timeout http-request 10s
    timeout http-keep-alive 10s
    timeout client  5m
    timeout server  15m
    timeout tunnel  2h
    timeout client-fin 30s
    timeout server-fin 30s
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 404 /etc/haproxy/errors/404.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

{% for host in haproxy if host.users is defined %}
userlist {{ host.hostname | replace('.', '-') }}-credentials
{% for user in host.users %}
  user {{ user.username }} insecure-password {{ user.password }}
{% endfor %}

{% endfor %}

frontend prometheus-frontend
   bind [::1]:8405
   option dontlog-normal
   http-request use-service prometheus-exporter if { path /metrics }

frontend haproxy-frontend
{% for ip in haproxy_listen %}
    bind {{ ip }}:80 v4v6
    bind {{ ip }}:443 v4v6 ssl crt /etc/haproxy/ssl/default.pem crt /etc/haproxy/ssl strict-sni alpn h2,http/1.1
{% if ip.startswith('[') %}
    bind quic6@{{ ip }}:443 ssl crt /etc/haproxy/ssl/default.pem crt /etc/haproxy/ssl strict-sni alpn h3
{% else %}
    bind quic4@{{ ip }}:443 ssl crt /etc/haproxy/ssl/default.pem crt /etc/haproxy/ssl strict-sni alpn h3
{% endif %}
{% endfor %}

    mode http

    # X_Forwarded-For contournerait les del-header une fois passé en FastCGI
    option http-restrict-req-hdr-names delete

    # Seuls les en-têtes de proxy écrits par HAProxy arrivent aux backends
    http-request del-header X-Forwarded-For
    http-request del-header X-Forwarded-Proto
    http-request del-header X-Forwarded-Host
    http-request del-header X-Forwarded-Port
    http-request del-header X-Real-IP
    http-request del-header Forwarded

    # Empreinte JA4 et User-Agent écrits dans les logs
    http-request lua.fingerprint_ja4 if { ssl_fc }
    http-request capture var(txn.fingerprint_ja4) len 36
    http-request capture req.hdr(user-agent) len 150

    # Enable http3
    http-response set-header alt-svc "h3=\":443\";ma=900;"

    # enable HSTS
    http-response set-header Strict-Transport-Security "max-age=63072000"

    # En-têtes OWASP, sauf si l'application les envoie déjà
    http-response set-header X-Content-Type-Options "nosniff" unless { res.hdr(X-Content-Type-Options) -m found }
    http-response set-header X-Frame-Options "SAMEORIGIN" unless { res.hdr(X-Frame-Options) -m found }
    # no-referrer met Origin à null sur les POST, ce que refuse le CSRF de Django (authentik)
    http-response set-header Referrer-Policy "same-origin" unless { res.hdr(Referrer-Policy) -m found }
    http-response set-header Permissions-Policy "accelerometer=(), autoplay=(self), camera=(self), cross-origin-isolated=(), display-capture=(self), encrypted-media=(self), fullscreen=(self), geolocation=(self), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(self), screen-wake-lock=(self), sync-xhr=(self), usb=(), web-share=(self), xr-spatial-tracking=(), clipboard-read=(self), clipboard-write=(self), gamepad=(), hid=(), idle-detection=(), interest-cohort=(), serial=(), unload=()" unless { res.hdr(Permissions-Policy) -m found }
    http-response set-header X-Permitted-Cross-Domain-Policies "none" unless { res.hdr(X-Permitted-Cross-Domain-Policies) -m found }
    http-response set-header X-DNS-Prefetch-Control "off" unless { res.hdr(X-DNS-Prefetch-Control) -m found }
    http-response set-header X-XSS-Protection "0"

    # En-têtes qui révèlent le logiciel ou sa version
    http-response del-header Server
    http-response del-header X-Powered-By
    http-response del-header X-Generator
    http-response del-header X-Php-Version
    http-response del-header X-Redirect-By
    http-response del-header X-AspNet-Version
    http-response del-header X-SourceMap
    http-response del-header SourceMap

{% for redirect in haproxy_redirect %}
    http-request redirect prefix https://{{ redirect.to }} code 301 if { hdr(host),field(1,:) -i {{ redirect.from }} }
{% endfor %}

{% for host in haproxy %}
    acl {{ host.hostname | replace('.', '-') }}-acl hdr(host),field(1,:) {{ host.hostname }}
{% if 'alt_hostnames' in host %}
{% for alt_host in host.alt_hostnames %}
    acl {{ alt_host | replace('.', '-') }}-acl hdr(host),field(1,:) {{ alt_host }}
{% endfor %}
{% endif %}
{% if 'deny_paths' in host %}
{% for deny_path in host.deny_paths %}
    acl {{ host.hostname | replace('.', '-') }}-deny-acl path,url_dec,lower,regsub(/+,/,g) -m beg {{ deny_path | lower }}
{% endfor %}
    http-request deny if {{ host.hostname | replace('.', '-') }}-acl {{ host.hostname | replace('.', '-') }}-deny-acl
{% if 'alt_hostnames' in host %}
{% for alt_host in host.alt_hostnames %}
    http-request deny if {{ alt_host | replace('.', '-') }}-acl {{ host.hostname | replace('.', '-') }}-deny-acl
{% endfor %}
{% endif %}
{% endif %}
{% for rule in host.http_request_rules | default([]) %}
    http-request {{ rule.action }} if {{ host.hostname | replace('.', '-') }}-acl {{ rule.condition }}
{% endfor %}

{% endfor %}
    redirect scheme https code 308 if !{ ssl_fc }

{% for host in haproxy %}
    use_backend {{ host.hostname | replace('.', '-') }}-backend if {{ host.hostname | replace('.', '-') }}-acl
{% if 'alt_hostnames' in host %}
{% for alt_host in host.alt_hostnames %}
    use_backend {{ host.hostname | replace('.', '-') }}-backend if {{ alt_host | replace('.', '-') }}-acl
{% endfor %}
{% endif %}
{% endfor %}
    default_backend default-backend

backend default-backend
    http-request return status 404 default-errorfiles

{% for host in haproxy %}
backend {{ host.hostname | replace('.', '-') }}-backend
    http-request add-header X-Forwarded-Proto https if { ssl_fc }
    mode http
{% if "healthcheck_url" in host and host.healthcheck_url %}
    option httpchk {{ host.healthcheck_url }}
{% endif %}
    option forwardfor
    option http-server-close
{% if host.users is defined %}
    http-request auth unless { http_auth({{ host.hostname | replace('.', '-') }}-credentials) }
{% endif %}
{% if host.headers is defined %}
{% for header_name, header_value in host.headers.items() %}
    http-response set-header {{ header_name }} "{{ header_value }}"
{% endfor %}
{% endif %}
{% if "timeout" in host and host.timeout %}
    timeout server {{ host.timeout }}
{% endif %}
{% for target in host.target %}
    server {{ target | replace('.', '-') }} {{ target }}:{{ host.target_port }} {% if "healthcheck" in host and host.healthcheck %}check port {{ host.target_port }}{% endif %} {% if "ssl" in host %}ssl check-ssl{% endif %} {% if "ssl_verify" in host and not host.ssl_verify %}verify none{% endif %}

{% endfor %}

{% endfor %}

{% if haproxy_postgresql | length > 0 %}
listen postgresql-primary
{% for ip in haproxy_listen %}
    bind {{ ip }}:5432 v4v6
{% endfor %}
    mode tcp
    timeout client 30m
    timeout server 30m
    option	tcplog
    option httpchk OPTIONS /read-write
    default-server on-marked-down shutdown-sessions
{% for target in haproxy_postgresql %}
    server {{ target | replace('.', '-') }} {{ target }}:5432 check port 8008
{% endfor %}

listen postgresql-replica
{% for ip in haproxy_listen %}
    bind {{ ip }}:5433 v4v6
{% endfor %}    mode tcp
    timeout client 30m
    timeout server 30m
    option	tcplog
    option httpchk OPTIONS /read-only
    default-server on-marked-down shutdown-sessions
{% for target in haproxy_postgresql %}
    server {{ target | replace('.', '-') }} {{ target }}:5432 check port 8008
{% endfor %}
{% endif %}


{% if haproxy_valkey | length > 0 %}
listen valkey-primary
{% for ip in haproxy_listen %}
    bind {{ ip }}:6379 v4v6
{% endfor %}
    mode tcp
    timeout client 30m
    timeout server 30m
    option tcplog
    option tcp-check
    tcp-check connect
    tcp-check send AUTH\ haproxy\ {{ haproxy_valkey_password }}\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send info\ replication\r\n
    tcp-check expect string role:master
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    default-server on-marked-down shutdown-sessions
{% for target in haproxy_valkey %}
    server {{ target | replace('.', '-') }} {{ target }}:6379 check port 6379 inter 2s fall 3 rise 2
{% endfor %}
{% endif %}
