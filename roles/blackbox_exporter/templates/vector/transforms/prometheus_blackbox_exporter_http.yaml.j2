{{ ansible_managed | comment }}

type: "remap"
inputs:
  - "blackbox_exporter_http_{{ probe_hostname | replace(".", "_") }}"
source: |
  # La query string est retirée, elle peut contenir des secrets (tokens)
  .tags.url = "{{ probe.url | split('?') | first }}"
  .tags.target = "{{ probe_hostname }}"
  .tags.host = "{{ probe_hostname }}"
  .tags.type = "http"
  .tags.module = "{{ probe_name }}"
  .tags.check_cert_expiry = "{{ probe.check_cert_expiry | default(false) | int }}"
  .
