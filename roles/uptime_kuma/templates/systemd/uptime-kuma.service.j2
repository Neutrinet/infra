{{ ansible_managed | comment }}

[Unit]
Description=Uptime Kuma: monitoring tool
After=network.target

[Service]
Type=simple
Restart=always
User={{ uptime_kuma_owner }}
Group={{ uptime_kuma_owner }}

WorkingDirectory=/var/www/{{ uptime_kuma_owner }}/dist/
ExecStart=node server/server.js --host=::1 --port=3001

PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/uptime-kuma
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
NoNewPrivileges=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
