{{ ansible_managed | comment }}

concurrent = 2
check_interval = 0
# Prometheus metrics
listen_address = "localhost:9252"

[session_server]
  session_timeout = 1800

{% if gitlab_runner_token %}
[[runners]]
  name = "{{ inventory_hostname }}"
  url = "{{ gitlab_runner_api_url }}"
  token = "{{ gitlab_runner_token }}"
  executor = "docker"
  request_concurrency = 2
  # Job log size in KB: a [[runners]] option, ignored under [runners.docker]
  output_limit = 32768
  [runners.feature_flags]
    FF_USE_INIT_WITH_DOCKER_EXECUTOR = true
    FF_GIT_URLS_WITHOUT_TOKENS = true
  [runners.cache]
    [runners.cache.s3]
  [runners.docker]
    tls_verify = false
    image = "alpine:latest"
    privileged = false
    memory = "1536m"
    security_opt = ["no-new-privileges:true"]
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = ["/cache"]
    shm_size = 0
    pull_policy = "if-not-present"
{% endif %}

# initramfs job of mikrotik-openwrt (tag neutrinet-openwrt): full OpenWrt build
[[runners]]
  name = "{{ inventory_hostname }}-openwrt"
  url = "{{ gitlab_runner_api_url }}"
  token = "{{ gitlab_runner_openwrt_token }}"
  executor = "docker"
  limit = 1
  output_limit = 32768
  [runners.feature_flags]
    FF_USE_INIT_WITH_DOCKER_EXECUTOR = true
    FF_GIT_URLS_WITHOUT_TOKENS = true
  [runners.docker]
    tls_verify = false
    image = "alpine:latest"
    privileged = false
    memory = "8g"
    security_opt = ["no-new-privileges:true"]
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    # OpenWrt checkout, dl/ and ccache kept between jobs, on the Docker disk
    volumes = ["openwrt-cache:/cache"]
    shm_size = 0
    pull_policy = "if-not-present"
