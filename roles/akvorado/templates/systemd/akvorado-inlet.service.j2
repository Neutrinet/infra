{{ ansible_managed | comment }}

[Unit]
Description=Akvorado Inlet
Documentation=https://akvorado.net/
After=network.target akvorado-orchestrator.service
Wants=akvorado-orchestrator.service

[Service]
Type=simple
User=akvorado
Group=akvorado
ExecStart=/usr/local/bin/akvorado inlet http://[::1]:8080
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=akvorado-inlet

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF
LimitNOFILE=65536
MemoryMax={{ akvorado_inlet_memory_max }}
LockPersonality=true
NoNewPrivileges=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
RemoveIPC=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=noaccess
ProtectSystem=strict
SystemCallFilter=@system-service bpf

[Install]
WantedBy=multi-user.target
