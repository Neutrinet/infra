{{ ansible_managed | comment }}

http://{{ zammad_domain }} {
    encode gzip zstd

    root * /opt/zammad/public

    request_body {
        max_size 50MB
    }

    @static {
        path /assets/*
        path /robots.txt
        path /humans.txt
        path /favicon.ico
        path /apple-touch-icon.png
    }

    handle @static {
        file_server
    }

    reverse_proxy localhost:3000 {
        header_up CLIENT_IP {remote_host}

        transport http {
            read_timeout 5m
        }

        trusted_proxies {{ caddy_trusted_proxies | join(' ') }}
    }

    reverse_proxy /ws* localhost:6042 {
        header_up CLIENT_IP {remote_host}
        stream_timeout 24h
        stream_close_delay 5m

        transport http {
            read_timeout 24h
        }

        trusted_proxies {{ caddy_trusted_proxies | join(' ') }}
    }

    log {
        output file /var/log/caddy/{{ zammad_owner }}.log
    }
}
