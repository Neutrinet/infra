#jinja2: variable_start_string:'{{{', variable_end_string: '}}}'
{{{ ansible_managed | comment }}}

{% if postgresql_patroni_hosts | length > 0 %}
groups:
  - name: Patroni
    rules:
      - alert: Patroni Primary
        for: 5m
        expr: sum by (scope) (patroni_primary) != 1
        labels:
          severity: critical
        annotations:
          summary: 'Incorrect number of primary server for the Patroni cluster.'
          description: '[Patroni cluster {{ $labels.scope }}]  Incorrect number of primary server: {{ $value }}.'

      - alert: Patroni Replica
        for: 15m
        expr: sum by (scope) (patroni_replica) != 2
        labels:
          severity: warning
        annotations:
          summary: 'Incorrect number of replica server for the Patroni cluster.'
          description: '[Patroni cluster {{ $labels.scope }}] Incorrect number of replica server: {{ $value }}.'

      - alert: PostgreSQL Running
        for: 5m
        expr: 'patroni_postgres_running == 0'
        labels:
          severity: critical
        annotations:
          summary: 'PostgreSQL is not running in the Patroni cluster.'
          description: '[{{ $labels.instance }}] [Patroni cluster {{ $labels.scope }}] PostgreSQL is not running.'

      - alert: Patroni Down
        # Sans Patroni, ses métriques disparaissent et les alertes ci-dessus restent muettes.
        expr: 'static_heartbeat{instance=~"{{{ postgresql_patroni_hosts | join('|') }}}"} unless on (instance) patroni_postgres_running'
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: Patroni is down
          description: "[{{ $labels.instance }}] Vector is running but Patroni metrics are missing, Patroni is probably stopped."

      - alert: PostgreSQL Replication Lag
        expr: pg_replication_lag_seconds > 300 and on (instance) pg_replication_is_replica == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: PostgreSQL replica is {{ humanizeDuration $value }} behind the primary
          description: "[{{ $labels.instance }}] PostgreSQL replica is > 5 minutes behind the primary (current = {{ humanizeDuration $value }})"

      - alert: Patroni Paused
        # Mode maintenance oublié : plus de failover automatique.
        expr: max by (scope) (patroni_is_paused) == 1
        for: 1h
        labels:
          severity: warning
          frequency: daily
        annotations:
          summary: Patroni cluster {{ $labels.scope }} is paused
          description: "[Patroni cluster {{ $labels.scope }}] Maintenance mode is enabled since more than 1h, automatic failover is disabled (patronictl resume)."

      - alert: Patroni Pending Restart
        expr: count by (scope) (patroni_pending_restart == 1)
        for: 1h
        labels:
          severity: info
          frequency: daily
        annotations:
          summary: Patroni cluster {{ $labels.scope }} has {{ $value }} nodes pending a restart
          description: "[Patroni cluster {{ $labels.scope }}] {{ $value }} nodes need a restart to apply their configuration (patronictl restart --pending)."

      - alert: PostgreSQL Behind Timeline
        for: 10m
        expr: stdvar by (scope) (patroni_postgres_timeline) > 0
        labels:
          severity: warning
        annotations:
          description: '[Patroni cluster {{ $labels.scope }}] PostgreSQL is deviating from the main timeline.'
          summary: 'PostgreSQL is deviating from the main timeline.'

  - name: Etcd
    rules:
      - alert: Etcd Cluster Size
        for: 15m
        expr: count(etcd_server_id) != 3
        labels:
          severity: critical
        annotations:
          description: 'Incorrect number of hosts for the Etcd cluster: {{ $value }}.'
          summary: 'Incorrect number of hosts for the Etcd cluster.'

      - alert: Etcd Leader
        for: 5m
        expr: etcd_server_has_leader != 1
        labels:
          severity: critical
        annotations:
          description: 'Etcd cluster has no leader on instance {{ $labels.instance }}.'
          summary: 'Etcd cluster has no leader.'

      - alert: Etcd Leader Changes
        expr: 'max(increase(etcd_server_leader_changes_seen_total[1h])) >= 5'
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: Etcd high number of leader changes
          description: "Etcd leader changed >= 5 times during last 1h (current = {{ $value }})"

      - alert: Etcd Member Communication Slow
        expr: histogram_quantile(0.99, rate(etcd_network_peer_round_trip_time_seconds_bucket[1m])) > 0.15
        for: 5m
        labels:
          severity: info
        annotations:
          summary: Etcd member communication slow
          description: "[{{ $labels.instance }}] Etcd member communication slowing down, 99th percentile is > 0.15s (current = {{ $value }})"

      - alert: Etcd High Number Of Failed Proposals
        expr: max(increase(etcd_server_proposals_failed_total[1h])) > 5
        for: 5m
        labels:
          severity: info
        annotations:
          summary: Etcd high number of failed proposals
          description: "Etcd cluster got > 5 failed proposals in past hour (current = {{ $value }})"
{% endif %}
