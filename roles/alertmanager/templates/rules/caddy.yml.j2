#jinja2: variable_start_string:'{{{', variable_end_string: '}}}'
{{{ ansible_managed | comment }}}

groups:
  - name: Caddy
    # Le label proxy (ex. doc-neutrinet-be-backend) est commun avec les probes et HAProxy pour les inhibitions.
    rules:
      - alert: Caddy High HTTP 5xx Error Rate
        for: 5m
        keep_firing_for: 10m
        expr: 'sum without (code) (rate(caddy_http_request_duration_seconds_count{code=~"5.."}[5m])) / sum without (code) (rate(caddy_http_request_duration_seconds_count[5m])) > 0.1 and sum without (code) (rate(caddy_http_request_duration_seconds_count[5m])) > 0.1'
        labels:
          severity: critical
          category: caddy.http
          code_category: 5xx
        annotations:
          summary: 'Caddy HTTP 5xx error rate is at {{ humanizePercentage $value }} for {{ $labels.host }}'
          description: '[{{ $labels.instance }}] [{{ $labels.host }}] Caddy HTTP 5xx error rate is > 10% in the last 5 minutes (current = {{ humanizePercentage $value }})'

      - alert: Caddy High HTTP 4xx Error Rate
        for: 15m
        keep_firing_for: 10m
        # Les bots provoquent des rafales de 4xx : seul un taux élevé qui dure, avec du trafic, est remonté.
        expr: sum without (code) (rate(caddy_http_request_duration_seconds_count{code=~"4.."}[5m])) / sum without (code) (rate(caddy_http_request_duration_seconds_count[5m])) > 0.5 and sum without (code) (rate(caddy_http_request_duration_seconds_count[5m])) > 0.5
        labels:
          severity: info
          category: caddy.http
          code_category: 4xx
        annotations:
          summary: 'Caddy HTTP 4xx error rate is at {{ humanizePercentage $value }} for {{ $labels.host }}'
          description: '[{{ $labels.instance }}] [{{ $labels.host }}] Caddy HTTP 4xx error rate is > 50% in the last 5 minutes (current = {{ humanizePercentage $value }})'

      - alert: Caddy Reverse Proxy Down
        expr: caddy_reverse_proxy_upstreams_healthy == 0
        for: 15m
        labels:
          severity: critical
          category: caddy.health
        annotations:
          summary: Caddy reverse proxy to {{ $labels.upstream }} is down.
          description: "[{{ $labels.instance }}] Caddy reverse proxy to {{ $labels.upstream }} is down."
