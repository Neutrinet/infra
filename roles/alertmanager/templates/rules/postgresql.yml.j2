#jinja2: variable_start_string:'{{{', variable_end_string: '}}}'
{{{ ansible_managed | comment }}}

groups:
  - name: PostgreSQL
    rules:
      - alert: PostgreSQL Exporter Error
        expr: pg_up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: PostgreSQL exporter can't connect to PostgreSQL
          description: "[{{ $labels.instance }}] PostgreSQL exporter can't connect to PostgreSQL, the PostgreSQL metrics are missing."

      - alert: PostgreSQL Too Many Connections
        expr: sum by (instance) (pg_stat_activity_count) > min by (instance) (pg_settings_max_connections) * 0.8
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: PostgreSQL connections are at {{ $value }}
          description: "[{{ $labels.instance }}] PostgreSQL uses > 80% of max_connections (current = {{ $value }})"

      - alert: PostgreSQL Dead Locks
        expr: increase(pg_stat_database_deadlocks{datname!~"template.*|postgres"}[5m]) > 5
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: PostgreSQL dead locks on database {{ $labels.datname }}
          description: "[{{ $labels.instance }}] {{ $value }} dead locks on database {{ $labels.datname }} in the last 5 minutes."

      - alert: PostgreSQL Replication Slot Inactive
        # Un slot inactif sur le primaire retient le WAL jusqu'à max_slot_wal_keep_size.
        expr: pg_replication_slots_slot_is_active == 0 and on (instance) pg_replication_is_replica == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: PostgreSQL replication slot {{ $labels.slot_name }} is inactive
          description: "[{{ $labels.instance }}] Replication slot {{ $labels.slot_name }} is inactive on the primary, the replica is probably down."

      - alert: PostgreSQL Replication Slot WAL Lost
        expr: pg_replication_slots_wal_status{wal_status="lost"} == 1
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: PostgreSQL replication slot {{ $labels.slot_name }} lost its WAL
          description: "[{{ $labels.instance }}] Replication slot {{ $labels.slot_name }} lost required WAL files, the replica must be rebuilt."
