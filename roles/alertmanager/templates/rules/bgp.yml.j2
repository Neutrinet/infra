#jinja2: variable_start_string:'{{{', variable_end_string: '}}}'
{{{ ansible_managed | comment }}}

groups:
- name: BGP Sessions
  # La criticité dépend du type de session, préfixe du nom généré par le rôle bird
  # (<type>_<slug>_v4/v6) : transit et réseau interne critiques, route servers d'IX en warning,
  # peerings et le reste en info.
  rules:
  - alert: BGP State Down
    expr: bird_protocol_up{proto="BGP", state!="Passive", name=~"(transit|route_reflector|core|edge)_.*"} == 0
    for: 5m
    keep_firing_for: 10m
    labels:
      severity: critical
    annotations:
      summary: "BGP session {{ $labels.name }} is down"
      description: '[{{ $labels.instance }}] BGP session {{ $labels.name }} is down (state = {{ $labels.state }}).'

  - alert: BGP State Down
    expr: bird_protocol_up{proto="BGP", state!="Passive", name=~"route_server_.*"} == 0
    for: 5m
    keep_firing_for: 10m
    labels:
      severity: warning
    annotations:
      summary: "BGP session {{ $labels.name }} is down"
      description: '[{{ $labels.instance }}] BGP session {{ $labels.name }} is down (state = {{ $labels.state }}).'

  - alert: BGP State Down
    expr: bird_protocol_up{proto="BGP", state!="Passive", name!~"(transit|route_reflector|core|edge|route_server)_.*"} == 0
    for: 5m
    keep_firing_for: 10m
    labels:
      severity: info
    annotations:
      summary: "BGP session {{ $labels.name }} is down"
      description: '[{{ $labels.instance }}] BGP session {{ $labels.name }} is down (state = {{ $labels.state }}).'
