{{ ansible_managed | comment }}

# See https://prometheus.io/docs/alerting/configuration/ for documentation.

# The directory from which notification templates are read.
templates:
  - /etc/alertmanager/templates/*.tmpl

# The root route on which each incoming alert enters.
route:
  # The labels by which incoming alerts are grouped together. For example,
  # multiple alerts coming in for cluster=A and alertname=LatencyHigh would
  # be batched into a single group.
  group_by: ['...']

  # When a new group of alerts is created by an incoming alert, wait at
  # least 'group_wait' to send the initial notification.
  # This way ensures that you get multiple alerts for the same group that start
  # firing shortly after another are batched together on the first
  # notification.
  # Les alertes sources (Instance Down, Datacenter Down, Website Down...) doivent arriver
  # avant d'envoyer les autres pour que les inhibitions s'appliquent.
  group_wait: 1m

  # When the first notification was sent, wait 'group_interval' to send a batch
  # of new alerts that started firing for that group.
  group_interval: 1m

  # If an alert has successfully been sent, wait 'repeat_interval' to
  # resend them.
  repeat_interval: {{ alertmanager_repeat_interval }}

  # A default receiver
  receiver: production-receiver

  # All the above attributes are inherited by all child routes and can
  # overwritten on each.

  # The child route trees.
  routes:
    - matchers:
        - severity = info
      receiver: dummy-receiver
{% if alertmanager_staging_labels %}
    - matchers:
{% for label_name, label_value in alertmanager_staging_labels.items() %}
        - {{ label_name }} = {{ label_value }}
{% endfor %}
      routes:
        - matchers:
            - frequency = monthly
          repeat_interval: 30d
          receiver: staging-receiver
        - matchers:
            - frequency = weekly
          repeat_interval: 1w
          receiver: staging-receiver
        - matchers:
            - frequency = daily
          repeat_interval: 1d
          receiver: staging-receiver
        - receiver: staging-receiver
{% endif %}
    - matchers:
        - frequency = monthly
      repeat_interval: 30d
      receiver: production-receiver
    - matchers:
        - frequency = weekly
      repeat_interval: 1w
      receiver: production-receiver
    - matchers:
        - frequency = daily
      repeat_interval: 1d
      receiver: production-receiver
    - receiver: production-receiver

receivers:
  - name: dummy-receiver
  - name: production-receiver
    webhook_configs:
      # Send alerts to matrix-alertbot, which will forward them to the Matrix room for alerts in production
      - url: http://localhost:4060/alerts/{{ alertmanager_matrix_alertbot_room }}
        send_resolved: true
  - name: staging-receiver
    webhook_configs:
      # Send alerts to matrix-alertbot, which will forward them to the Matrix room for alerts in staging
      - url: http://localhost:4060/alerts/{{ alertmanager_staging_matrix_alertbot_room }}
        send_resolved: true
inhibit_rules:
  # Datacenter down: hide all other alerts from this datacenter
  - target_matchers:
      - category != base.datacenter
    source_matchers:
      - category = base.datacenter
    equal: ['datacenter']

  # Most of the probed services are hosted in LouiseDC: when it is down,
  # hide the probe alerts, which have no datacenter label for the target.
  - target_matchers:
      - category =~ "probe[.].*"
    source_matchers:
      - category = base.datacenter

  # Instance down: hide all other alerts from this instance
  - target_matchers:
      - category != base.health
    source_matchers:
      - category = base.health
    equal: ['instance']

  # Clock not synchronising on several hosts of a datacenter: hide the alerts per host
  - target_matchers:
      - category = base.clock
    source_matchers:
      - category = base.clock_datacenter
    equal: ['datacenter']

  # Combine VPN alerts for different ports and protocols
  # to single alert for TCP protocol and 1195 port.
  - target_matchers:
      - protocol != tcp
      - port != 1195
    source_matchers:
      - category = probe.vpn
      - protocol = tcp
      - port = 1195
    equal: ['alertname', 'category', 'address']

  # Website down: keep only this alert for the site, hide the HTTP errors
  # and slowness seen by the probes, HAProxy and Caddy (the cause, like a failed
  # systemd service, is still notified)
  - target_matchers:
      - category =~ "probe[.]http_(error|slow)|haproxy[.]health"
    source_matchers:
      - category = probe.http_down
    equal: ['proxy']

  # Website down or HTTP failure: hide the HTTP errors seen by HAProxy and Caddy for the same site
  - target_matchers:
      - category =~ "haproxy[.]http|caddy[.]http"
      - code_category = 5xx
    source_matchers:
      - category =~ "probe[.]http_(down|error)"
    equal: ['proxy']

  # HAProxy backend down: hide the HAProxy HTTP errors of this backend
  - target_matchers:
      - category = haproxy.http
      - code_category = 5xx
    source_matchers:
      - category = haproxy.health
    equal: ['proxy']

  # Same errors from Caddy: hide the HAProxy HTTP errors of this backend
  - target_matchers:
      - category = haproxy.http
      - code_category = 5xx
    source_matchers:
      - category = caddy.http
      - code_category = 5xx
    equal: ['proxy']

  # Hide Caddy alerts about HTTP errors when reverse proxy is down
  - target_matchers:
      - category =~ caddy.http
    source_matchers:
      - category = caddy.health
    equal: ['instance']

  # Hide Backup errors when {{ inventory_hostname }} is down
  - target_matchers:
      - category = base.backup
      - instance != {{ inventory_hostname }}
    source_matchers:
      - category = base.health
      - instance = {{ inventory_hostname }}
