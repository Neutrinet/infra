{{ ansible_managed | comment }}
{% macro detect_language() %}
        user = request.user
        if hasattr(user, "locale"):
            language = user.locale(request.http_request)
        else:
            language = getattr(request.http_request, "LANGUAGE_CODE", "")
        language = (language or "").replace("_", "-").split("-")[0].lower()
        if language not in {{ _authentik_languages | to_json }}:
            language = "en"
{% endmacro %}
version: 1
metadata:
  name: Neutrinet - Policies
entries:
{% for lang in _authentik_languages %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-language-{{ lang }}
    attrs:
      expression: |
{{ detect_language() }}
        return language == "{{ lang }}"

{% endfor %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-flow-restored
    attrs:
      expression: |
        return bool(request.context.get("is_restored"))

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-red
    attrs:
      expression: |
        return ak_is_group_member(request.user, name="red")

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-privileged
    attrs:
      expression: |
        return request.user.is_superuser or ak_is_group_member(request.user, name="red")

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-not-privileged
    attrs:
      expression: |
        return not (request.user.is_superuser or ak_is_group_member(request.user, name="red"))

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-red-admin-only
    attrs:
      expression: |
        return ak_is_group_member(request.user, name="red") and not request.user.username.endswith("-admin")

  - model: authentik_policies_reputation.reputationpolicy
    identifiers:
      name: neutrinet-reputation-ip
    attrs:
      check_ip: true
      check_username: false
      threshold: -5

  - model: authentik_policies_password.passwordpolicy
    identifiers:
      name: neutrinet-password
    attrs:
      password_field: password
      check_static_rules: false
      check_have_i_been_pwned: true
      hibp_allowed_count: 0
      check_zxcvbn: true
      zxcvbn_score_threshold: 2

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-password-length
    attrs:
      expression: |
{{ detect_language() }}
        messages = {{ _authentik_i18n.msg_password_length | to_json }}
        if len(request.context.get("prompt_data", {}).get("password", "")) < 12:
            ak_message(messages[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-username
    attrs:
      expression: |
        import re
{{ detect_language() }}
        blocklist = set({{ _authentik_username_blocklist | to_json }})
        username = request.context.get("prompt_data", {}).get("username", "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{2,31}", username):
            ak_message({{ _authentik_i18n.msg_username_format | to_json }}[language])
            return False
        if username.endswith("-admin"):
            ak_message({{ _authentik_i18n.msg_username_admin_suffix | to_json }}[language])
            return False
        if username in blocklist:
            ak_message({{ _authentik_i18n.msg_username_reserved | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-username-red
    attrs:
      expression: |
        from authentik.core.models import User
        import re
{{ detect_language() }}
        blocklist = set({{ _authentik_username_blocklist | to_json }})
        username = request.context.get("prompt_data", {}).get("username", "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{2,25}-admin", username):
            ak_message({{ _authentik_i18n.msg_username_red_format | to_json }}[language])
            return False
        if username.removesuffix("-admin") in blocklist:
            ak_message({{ _authentik_i18n.msg_username_reserved | to_json }}[language])
            return False
        if User.objects.filter(username=username).exists():
            ak_message({{ _authentik_i18n.msg_username_taken | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-unique
    attrs:
      expression: |
        from authentik.core.models import User
{{ detect_language() }}
        email = request.context.get("prompt_data", {}).get("email", "")
        others = User.objects.filter(email__iexact=email)
        if request.user.is_authenticated:
            others = others.exclude(pk=request.user.pk)
        if email and others.exists():
            ak_message({{ _authentik_i18n.msg_email_taken | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-changed
    attrs:
      expression: |
        new = request.context.get("prompt_data", {}).get("email", "")
        if not new or new.lower() == (request.user.email or "").lower():
            return False
        request.context["flow_plan"].context["email"] = new
        request.context["flow_plan"].context["pending_user"] = request.user
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-notify-old
    attrs:
      expression: |
{{ detect_language() }}
        new = request.context.get("prompt_data", {}).get("email", "")
        old = request.user.email
        if old and new and new.lower() != old.lower() and request.context.get("is_restored"):
            ak_send_email(
                old,
                {{ _authentik_i18n.mail_email_changed_subject | to_json }}[language],
                body={{ _authentik_i18n.mail_email_changed_body | to_json }}[language].format(
                    username=request.user.username,
                    new=new,
                ),
            )
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-verified
    attrs:
      expression: |
        request.user.refresh_from_db()
        new = request.context.get("prompt_data", {}).get("email", "")
        if not new or new.lower() == (request.user.email or "").lower():
            return True
        token = request.context.get("is_restored")
        if not token:
            return False
        return token.plan.context.get("email", "").lower() == new.lower()

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-invitation-groups
    attrs:
      expression: |
        from authentik.core.models import Group
        names = request.context.get("prompt_data", {}).get("groups", [])
        allowed = [name for name in names if name in ("white", "green", "amber")]
        groups = list(Group.objects.filter(name__in=allowed))
        if groups:
            request.context["flow_plan"].context["groups"] = groups
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-red-invitation
    attrs:
      expression: |
        from datetime import timedelta
        from django.utils.timezone import now
        invite = request.context.get("invitation")
        if invite is None or invite.flow is None:
            return True
        if not invite.single_use:
            return True
        if not invite.expiring or invite.expires is None or invite.expires > now() + timedelta(days=7):
            return True
        if not ak_is_group_member(invite.created_by, name="red"):
            return True
        return False

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-user-path
    attrs:
      expression: |
        user = request.user
        for name in ("red", "amber", "green", "white"):
            if ak_is_group_member(user, name=name):
                if user.path != name:
                    user.path = name
                    user.save(update_fields=["path"])
                break
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-terminate-sessions
    attrs:
      expression: |
        from authentik.core.models import Session
        sessions = Session.objects.filter(authenticatedsession__user=request.user)
        current = request.http_request.session.session_key
        if current:
            sessions = sessions.exclude(session_key=current)
        sessions.delete()
        return True
