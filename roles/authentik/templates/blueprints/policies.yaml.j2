{{ ansible_managed | comment }}
{% macro detect_language() %}
        plan = request.context.get("flow_plan")
        if plan is None and request.http_request is not None:
            plan = request.http_request.session.get("authentik/flows/plan")
        language = plan.context.get("neutrinet_language", "") if plan is not None else ""
        if not language:
            attributes = getattr(request.user, "attributes", None) or {}
            language = (attributes.get("settings") or {}).get("locale", "")
            if not language and request.http_request is not None:
                language = getattr(request.http_request, "LANGUAGE_CODE", "")
            language = (language or "").replace("_", "-").split("-")[0].lower()
            if language not in {{ _authentik_languages | to_json }}:
                language = "en"
            if plan is not None:
                plan.context["neutrinet_language"] = language
{% endmacro %}
{% macro deny_message(key) %}
        if denied and request.context.get("flow_plan") is not None:
            request.context["flow_plan"].context["deny_message"] = {{ _authentik_i18n[key] | to_json }}[language]
        return denied
{% endmacro %}
version: 1
metadata:
  name: Neutrinet - Policies
entries:
{% for lang in _authentik_languages %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-language-{{ lang }}
    attrs:
      expression: |
{{ detect_language() }}
        return language == "{{ lang }}"

{% endfor %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-deny-all
    attrs:
      expression: |
        return False

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-pending-user
    attrs:
      expression: |
        request.context["flow_plan"].context["pending_user"] = request.user
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-different
    attrs:
      expression: |
{{ detect_language() }}
        new = request.context.get("prompt_data", {}).get("email", "")
        if new.lower() == (request.user.email or "").lower():
            ak_message({{ _authentik_i18n.msg_email_same | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-red
    attrs:
      expression: |
        return ak_is_group_member(request.user, name="red")

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-privileged
    attrs:
      expression: |
        return request.user.is_superuser or ak_is_group_member(request.user, name="red")

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-is-not-privileged
    attrs:
      expression: |
        return not (request.user.is_superuser or ak_is_group_member(request.user, name="red"))

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-red-admin-only
    attrs:
      expression: |
{{ detect_language() }}
        denied = ak_is_group_member(request.user, name="red") and not request.user.username.endswith("-admin")
{{ deny_message("msg_deny") }}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-reputation-ip
    attrs:
      expression: |
        from django.db.models import Sum
        from django.utils.timezone import now
        from authentik.policies.reputation.models import Reputation
        from authentik.root.middleware import ClientIPMiddleware
{{ detect_language() }}
        ip = ClientIPMiddleware.get_client_ip(request.http_request)
        failures = (
            Reputation.objects.filter(ip=ip, score__lt=0, expires__gt=now())
            .aggregate(total=Sum("score"))["total"]
            or 0
        )
        denied = failures <= -5
{{ deny_message("msg_deny_reputation") }}
  - model: authentik_policies_password.passwordpolicy
    identifiers:
      name: neutrinet-password
    attrs:
      password_field: password
      check_static_rules: false
      check_have_i_been_pwned: true
      hibp_allowed_count: 0
      check_zxcvbn: true
      zxcvbn_score_threshold: 2

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-password-length
    attrs:
      expression: |
{{ detect_language() }}
        messages = {{ _authentik_i18n.msg_password_length | to_json }}
        if len(request.context.get("prompt_data", {}).get("password", "")) < 12:
            ak_message(messages[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-username
    attrs:
      expression: |
        import re
{{ detect_language() }}
        blocklist = set({{ _authentik_username_blocklist | to_json }})
        username = request.context.get("prompt_data", {}).get("username", "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{2,31}", username):
            ak_message({{ _authentik_i18n.msg_username_format | to_json }}[language])
            return False
        if username.endswith("-admin"):
            ak_message({{ _authentik_i18n.msg_username_admin_suffix | to_json }}[language])
            return False
        if username in blocklist:
            ak_message({{ _authentik_i18n.msg_username_reserved | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-username-red
    attrs:
      expression: |
        from authentik.core.models import User
        import re
{{ detect_language() }}
        blocklist = set({{ _authentik_username_blocklist | to_json }})
        username = request.context.get("prompt_data", {}).get("username", "")
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{2,25}-admin", username):
            ak_message({{ _authentik_i18n.msg_username_red_format | to_json }}[language])
            return False
        if username.removesuffix("-admin") in blocklist:
            ak_message({{ _authentik_i18n.msg_username_reserved | to_json }}[language])
            return False
        if User.objects.filter(username=username).exists():
            ak_message({{ _authentik_i18n.msg_username_taken | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-unique
    attrs:
      expression: |
        from authentik.core.models import User
{{ detect_language() }}
        email = request.context.get("prompt_data", {}).get("email", "")
        others = User.objects.filter(email__iexact=email)
        if request.user.is_authenticated:
            others = others.exclude(pk=request.user.pk)
        if email and others.exists():
            ak_message({{ _authentik_i18n.msg_email_taken | to_json }}[language])
            return False
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-changed
    attrs:
      expression: |
        new = request.context.get("prompt_data", {}).get("email", "")
        if not new or new.lower() == (request.user.email or "").lower():
            return False
        request.context["flow_plan"].context["email"] = new
        return True

{% for name, keys in {"password": ["password", "password_repeat"], "email": ["email"]}.items() %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-write-{{ name }}-only
    attrs:
      expression: |
        plan = request.context["flow_plan"]
        data = plan.context.get("prompt_data", {})
        plan.context["prompt_data"] = {key: value for key, value in data.items() if key in {{ keys | to_json }}}
        for key in ("groups", "user_path", "user_type"):
            plan.context.pop(key, None)
        return True

{% endfor %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-reputation-reset
    attrs:
      expression: |
        from authentik.policies.reputation.models import Reputation
        from authentik.root.middleware import ClientIPMiddleware
        ip = ClientIPMiddleware.get_client_ip(request.http_request)
        Reputation.objects.filter(
            ip=ip, score__lt=0, identifier__in=[request.user.username, request.user.email]
        ).delete()
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-link-missing
    attrs:
      expression: |
{{ detect_language() }}
        token = request.context.get("is_restored")
        denied = not token or token.user_id != request.user.pk
{{ deny_message("msg_deny") }}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-verified
    attrs:
      expression: |
{{ detect_language() }}
        request.user.refresh_from_db()
        new = request.context.get("prompt_data", {}).get("email", "")
        old = request.user.email or ""
        if not new or new.lower() == old.lower():
            return True
        token = request.context.get("is_restored")
        if not token or token.user_id != request.user.pk or token.plan.context.get("email", "").lower() != new.lower():
            return False
        if old:
            ak_send_email(
                old,
                {{ _authentik_i18n.mail_email_changed_subject | to_json }}[language],
                template="neutrinet/email_changed.html",
                context={"lang": language, "username": request.user.username, "new": new},
            )
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-invitation-groups
    attrs:
      expression: |
        from authentik.core.models import Group
        names = request.context.get("prompt_data", {}).get("groups", [])
        allowed = [name for name in names if name in ("white", "green", "amber")]
        groups = list(Group.objects.filter(name__in=allowed))
        if groups:
            request.context["flow_plan"].context["groups"] = groups
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-red-invitation
    attrs:
      expression: |
        from datetime import timedelta
        from django.utils.timezone import now
{{ detect_language() }}
        def invalid():
            invite = request.context.get("invitation")
            if invite is None or invite.flow is None:
                return True
            if not invite.single_use:
                return True
            if not (invite.fixed_data or {}).get("email"):
                return True
            if not invite.expiring or invite.expires is None or invite.expires > now() + timedelta(hours=48):
                return True
            if not ak_is_group_member(invite.created_by, name="red"):
                return True
            return False
        denied = invalid()
{{ deny_message("msg_deny") }}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-user-path
    attrs:
      expression: |
        user = request.user
        for name in ("red", "amber", "green", "white"):
            if ak_is_group_member(user, name=name):
                if user.path != name:
                    user.path = name
                    user.save(update_fields=["path"])
                break
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-terminate-sessions
    attrs:
      expression: |
        from authentik.core.models import Session
        from authentik.providers.oauth2.models import AccessToken, RefreshToken
        sessions = Session.objects.filter(authenticatedsession__user=request.user)
        current = request.http_request.session.session_key
        if current:
            sessions = sessions.exclude(session_key=current)
        sessions.delete()
        RefreshToken.objects.filter(user=request.user).delete()
        AccessToken.objects.filter(user=request.user).delete()
        return True
