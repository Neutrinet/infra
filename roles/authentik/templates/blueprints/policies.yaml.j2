  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-email-verified
    attrs:
      expression: |
        plan = request.context.get("flow_plan")
        if plan is None and request.http_request is not None:
            plan = request.http_request.session.get("authentik/flows/plan")
        language = plan.context.get("neutrinet_language", "") if plan is not None else ""
        if not language:
            attributes = getattr(request.user, "attributes", None) or {}
            language = (attributes.get("settings") or {}).get("locale", "")
            if not language and request.http_request is not None:
                language = getattr(request.http_request, "LANGUAGE_CODE", "")
            language = (language or "").replace("_", "-").split("-")[0].lower()
            if language not in {{ _authentik_languages | to_json }}:
                language = "en"
            if plan is not None:
                plan.context["neutrinet_language"] = language

        request.user.refresh_from_db()
        new = request.context.get("prompt_data", {}).get("email", "")
        old = request.user.email or ""
        if not new or new.lower() == old.lower():
            return True
        token = request.context.get("is_restored")
        if not token or token.user_id != request.user.pk or token.plan.context.get("email", "").lower() != new.lower():
            return False
        if old:
            ak_send_email(
                old,
                {{ _authentik_i18n.mail_email_changed_subject | to_json }}[language],
                template=f"neutrinet/{language}/email_changed.html",
                context={"lang": language, "username": request.user.username, "new": new},
            )
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-invitation-groups
    attrs:
      expression: |
        from authentik.core.models import Group
        names = request.context.get("prompt_data", {}).get("groups", [])
        allowed = [name for name in names if name in ("white", "green", "amber")]
        groups = list(Group.objects.filter(name__in=allowed))
        if groups:
            request.context["flow_plan"].context["groups"] = groups
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-red-invitation
    attrs:
      expression: |
        from datetime import timedelta
        from django.utils.timezone import now
        plan = request.context.get("flow_plan")
        if plan is None and request.http_request is not None:
            plan = request.http_request.session.get("authentik/flows/plan")
        language = plan.context.get("neutrinet_language", "") if plan is not None else ""
        if not language:
            attributes = getattr(request.user, "attributes", None) or {}
            language = (attributes.get("settings") or {}).get("locale", "")
            if not language and request.http_request is not None:
                language = getattr(request.http_request, "LANGUAGE_CODE", "")
            language = (language or "").replace("_", "-").split("-")[0].lower()
            if language not in {{ _authentik_languages | to_json }}:
                language = "en"
            if plan is not None:
                plan.context["neutrinet_language"] = language

        def invalid():
            invite = request.context.get("invitation")
            if invite is None or invite.flow is None:
                return True
            if not invite.single_use:
                return True
            if invite.fixed_data:
                return True
            if not invite.expiring or invite.expires is None or invite.expires > now() + timedelta(hours=48):
                return True
            if not ak_is_group_member(invite.created_by, name="red"):
                return True
            return False
        denied = invalid()
        if denied and request.context.get("flow_plan") is not None:
            request.context["flow_plan"].context["deny_message"] = {{ _authentik_i18n.msg_deny | to_json }}[language]
        return denied

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-user-path
    attrs:
      expression: |
        plan = request.context.get("flow_plan")
        if plan is None and request.http_request is not None:
            plan = request.http_request.session.get("authentik/flows/plan")
        language = plan.context.get("neutrinet_language", "") if plan is not None else ""
        if not language:
            attributes = getattr(request.user, "attributes", None) or {}
            language = (attributes.get("settings") or {}).get("locale", "")
            if not language and request.http_request is not None:
                language = getattr(request.http_request, "LANGUAGE_CODE", "")
            language = (language or "").replace("_", "-").split("-")[0].lower()
            if language not in {{ _authentik_languages | to_json }}:
                language = "en"
            if plan is not None:
                plan.context["neutrinet_language"] = language

        user = request.user
        fields = []
        names = set(user.all_groups().values_list("name", flat=True))
        path = next((name for name in ("red", "amber", "green", "white") if name in names), None)
        if path and user.path != path:
            user.path = path
            fields.append("path")
        settings = user.attributes.get("settings") or {}
        if not settings.get("locale"):
            settings["locale"] = {{ _authentik_locale_tags | to_json }}[language]
            user.attributes["settings"] = settings
            fields.append("attributes")
        if fields:
            user.save(update_fields=fields)
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-terminate-sessions
    attrs:
      expression: |
        from authentik.core.models import Session, Token
        from authentik.providers.oauth2.models import AccessToken, RefreshToken
        sessions = Session.objects.filter(authenticatedsession__user=request.user)
        current = request.http_request.session.session_key
        if current:
            sessions = sessions.exclude(session_key=current)
        sessions.delete()
        RefreshToken.objects.filter(user=request.user).delete()
        AccessToken.objects.filter(user=request.user).delete()
        Token.objects.filter(user=request.user).delete()
        return True

  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-password-unchanged
    attrs:
      expression: |
        from django.utils.timezone import now
        from authentik.core.models import User
        if request.context.get("pending_user") is None:
            return False
        saved = getattr(request.user, "password_change_date", None)
        current = User.objects.filter(pk=request.user.pk).values_list("password_change_date", flat=True).first()
        if saved is None or current is None or current > saved:
            return False
        token = request.context.get("is_restored")
        if token is not None:
            if token.expiring and token.expires is not None and token.expires < now():
                return False
            sent = getattr(token.plan.context.get("pending_user"), "password_change_date", None)
            if sent is None or current > sent:
                return False
        return True
