  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-reputation-ip
    attrs:
      expression: |
        import ipaddress
        from django.db.models import Sum
        from django.utils.timezone import now
        from authentik.policies.reputation.models import Reputation
        from authentik.root.middleware import ClientIPMiddleware
        plan = request.context.get("flow_plan")
        if plan is None and request.http_request is not None:
            plan = request.http_request.session.get("authentik/flows/plan")
        language = plan.context.get("neutrinet_language", "") if plan is not None else ""
        if not language:
            attributes = getattr(request.user, "attributes", None) or {}
            language = (attributes.get("settings") or {}).get("locale", "")
            if not language and request.http_request is not None:
                language = getattr(request.http_request, "LANGUAGE_CODE", "")
            language = (language or "").replace("_", "-").split("-")[0].lower()
            if language not in {{ _authentik_languages | to_json }}:
                language = "en"
            if plan is not None:
                plan.context["neutrinet_language"] = language

        address = ipaddress.ip_address(ClientIPMiddleware.get_client_ip(request.http_request))
        if address.version == 6 and address.ipv4_mapped:
            address = address.ipv4_mapped
        if address.version == 6:
            networks = [str(ipaddress.ip_network(f"{address}/64", strict=False))] * 2
        else:
            networks = [f"{address}/32", f"::ffff:{address}/128"]
        in_network = {"where": ["(ip <<= %s::inet OR ip <<= %s::inet)"], "params": networks}
        failures = (
            Reputation.objects.filter(score__lt=0, expires__gt=now())
            .extra(**in_network)
            .aggregate(total=Sum("score"))["total"]
            or 0
        )
        denied = failures <= -5
        if denied and request.context.get("flow_plan") is not None:
            request.context["flow_plan"].context["deny_message"] = {{ _authentik_i18n.msg_deny_reputation | to_json }}[language]
        return denied

