{% for name, keys in {"password": ["password", "password_repeat"], "email": ["email"]}.items() %}
  - model: authentik_policies_expression.expressionpolicy
    identifiers:
      name: neutrinet-write-{{ name }}-only
    attrs:
      expression: |
        plan = request.context["flow_plan"]
        data = plan.context.get("prompt_data", {})
        plan.context["prompt_data"] = {key: value for key, value in data.items() if key in {{ keys | to_json }}}
        for key in ("groups", "user_path", "user_type"):
            plan.context.pop(key, None)
        return True

{% endfor %}
