{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - User settings
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-user-settings
    attrs:
      name: User settings
      title: Account settings
      designation: stage_configuration
      authentication: require_authenticated

  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-user-settings-write
    attrs:
      user_creation_mode: never_create
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    id: field-username-{{ lang }}
    identifiers:
      name: neutrinet-user-settings-field-username-{{ lang }}
    attrs:
      field_key: username
      label: {{ _authentik_i18n.username[lang] | to_json }}
      type: text_read_only
      required: false
      placeholder: {{ _authentik_i18n.username[lang] | to_json }}
      placeholder_expression: false
      initial_value: |
        try:
            return user.username
        except:
            return ''
      initial_value_expression: true
      sub_text: {{ _authentik_i18n.username_settings_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-name-{{ lang }}
    identifiers:
      name: neutrinet-user-settings-field-name-{{ lang }}
    attrs:
      field_key: name
      label: {{ _authentik_i18n.name[lang] | to_json }}
      type: text
      required: true
      placeholder: {{ _authentik_i18n.name[lang] | to_json }}
      placeholder_expression: false
      initial_value: |
        try:
            return user.name
        except:
            return ''
      initial_value_expression: true
      order: 1
  - model: authentik_stages_prompt.prompt
    id: field-email-{{ lang }}
    identifiers:
      name: neutrinet-user-settings-field-email-{{ lang }}
    attrs:
      field_key: email
      label: {{ _authentik_i18n.email[lang] | to_json }}
      type: text_read_only
      required: false
      placeholder: {{ _authentik_i18n.email[lang] | to_json }}
      placeholder_expression: false
      initial_value: |
        try:
            return user.email
        except:
            return ''
      initial_value_expression: true
      sub_text: {{ _authentik_i18n.email_change_link[lang] | to_json }}
      order: 2
  - model: authentik_stages_prompt.prompt
    id: field-locale-{{ lang }}
    identifiers:
      name: neutrinet-user-settings-field-locale-{{ lang }}
    attrs:
      field_key: attributes.settings.locale
      label: {{ _authentik_i18n.locale[lang] | to_json }}
      type: ak-locale
      required: true
      placeholder: {{ _authentik_i18n.locale[lang] | to_json }}
      placeholder_expression: false
      initial_value: |
        try:
            return user.attributes.get("settings", {}).get("locale", "")
        except:
            return ''
      initial_value_expression: true
      order: 3
  - model: authentik_stages_prompt.promptstage
    id: prompt-{{ lang }}
    identifiers:
      name: neutrinet-user-settings-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-username-{{ lang }}
        - !KeyOf field-name-{{ lang }}
        - !KeyOf field-email-{{ lang }}
        - !KeyOf field-locale-{{ lang }}
      validation_policies: []
  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt-{{ lang }}
      order: {{ 10 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

{% endfor %}

  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 40
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
