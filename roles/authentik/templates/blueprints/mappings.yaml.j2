{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Mappings
entries:
  - model: authentik_providers_oauth2.scopemapping
    identifiers:
      name: neutrinet-groups
    attrs:
      scope_name: groups
      description: User groups, including inherited groups
      expression: |
        return {
            "groups": [group.name for group in request.user.all_groups()],
        }
