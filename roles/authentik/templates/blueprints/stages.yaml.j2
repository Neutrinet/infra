{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Stages
entries:
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]]
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]]
    attrs:
      identifiers:
        name: Default - TOTP MFA setup flow
      required: false
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]]
    attrs:
      identifiers:
        name: Default - WebAuthn MFA setup flow
      required: false
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_authenticator_static.authenticatorstaticstage, [name, default-authenticator-static-setup]]]
    attrs:
      identifiers:
        name: Default - Static MFA setup flow
      required: false

  - model: authentik_stages_deny.denystage
    id: deny-reputation
    identifiers:
      name: neutrinet-deny-reputation
    attrs:
      deny_message: ""
  - model: authentik_stages_deny.denystage
    identifiers:
      name: neutrinet-deny-red-name
    attrs:
      deny_message: ""
  - model: authentik_stages_deny.denystage
    identifiers:
      name: neutrinet-deny-red
    attrs:
      deny_message: ""
  - model: authentik_stages_deny.denystage
    identifiers:
      name: neutrinet-deny-invitation
    attrs:
      deny_message: ""
  - model: authentik_stages_deny.denystage
    identifiers:
      name: neutrinet-deny-email-link
    attrs:
      deny_message: ""

  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    identifiers:
      name: neutrinet-mfa-privileged
    attrs:
      device_classes:
        - webauthn
        - totp
        - static
      not_configured_action: configure
      webauthn_user_verification: required
      configuration_stages:
        - !Find [authentik_stages_authenticator_webauthn.authenticatorwebauthnstage, [name, default-authenticator-webauthn-setup]]
        - !Find [authentik_stages_authenticator_totp.authenticatortotpstage, [name, default-authenticator-totp-setup]]
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    identifiers:
      name: neutrinet-mfa
    attrs:
      device_classes:
        - webauthn
        - totp
        - static
      not_configured_action: skip
  - model: authentik_stages_authenticator_validate.authenticatorvalidatestage
    identifiers:
      name: neutrinet-mfa-recovery-privileged
    attrs:
      device_classes:
        - webauthn
        - totp
        - static
      not_configured_action: deny
      webauthn_user_verification: required

  - model: authentik_stages_user_login.userloginstage
    identifiers:
      name: neutrinet-login-privileged
    attrs:
      session_duration: hours=8
      remember_me_offset: seconds=0
      network_binding: bind_asn
  - model: authentik_stages_user_login.userloginstage
    identifiers:
      name: neutrinet-login
    attrs:
      session_duration: hours=12
      remember_me_offset: days=30

  - model: authentik_stages_password.passwordstage
    id: password-check
    identifiers:
      name: neutrinet-password-check
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      failed_attempts_before_cancel: 5
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    identifiers:
      name: neutrinet-field-name-{{ lang }}
    attrs:
      field_key: name
      label: {{ _authentik_i18n.name[lang] | to_json }}
      type: text
      required: true
      placeholder: ""
      placeholder_expression: false
      order: 1
  - model: authentik_stages_prompt.prompt
    identifiers:
      name: neutrinet-field-password-{{ lang }}
    attrs:
      field_key: password
      label: {{ _authentik_i18n.password[lang] | to_json }}
      type: password
      required: true
      placeholder: ""
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.password_help[lang] | to_json }}
      order: 3
  - model: authentik_stages_prompt.prompt
    identifiers:
      name: neutrinet-field-password-repeat-{{ lang }}
    attrs:
      field_key: password_repeat
      label: {{ _authentik_i18n.password_repeat[lang] | to_json }}
      type: password
      required: true
      placeholder: ""
      placeholder_expression: false
      order: 4

  - model: authentik_stages_prompt.prompt
    id: field-new-password-{{ lang }}
    identifiers:
      name: neutrinet-field-new-password-{{ lang }}
    attrs:
      field_key: password
      label: {{ _authentik_i18n.new_password[lang] | to_json }}
      type: password
      required: true
      placeholder: ""
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.password_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-new-password-repeat-{{ lang }}
    identifiers:
      name: neutrinet-field-new-password-repeat-{{ lang }}
    attrs:
      field_key: password_repeat
      label: {{ _authentik_i18n.new_password_repeat[lang] | to_json }}
      type: password
      required: true
      placeholder: ""
      placeholder_expression: false
      order: 1
  - model: authentik_stages_prompt.prompt
    id: field-new-password-notice-{{ lang }}
    identifiers:
      name: neutrinet-field-new-password-notice-{{ lang }}
    attrs:
      field_key: neutrinet_revoke_notice
      label: Revocation notice
      type: static
      required: false
      placeholder: ""
      placeholder_expression: false
      initial_value: {{ _authentik_i18n.new_password_revoke_notice[lang] | to_json }}
      initial_value_expression: false
      order: 2
  - model: authentik_stages_prompt.promptstage
    identifiers:
      name: neutrinet-new-password-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-new-password-{{ lang }}
        - !KeyOf field-new-password-repeat-{{ lang }}
        - !KeyOf field-new-password-notice-{{ lang }}
      validation_policies:
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-length]]
        - !Find [authentik_policies_password.passwordpolicy, [name, neutrinet-password]]
{% endfor %}

  - model: authentik_stages_user_write.userwritestage
    identifiers:
      name: neutrinet-write
    attrs:
      user_creation_mode: never_create
{% for kind in ["totp", "webauthn", "static"] %}

  - model: authentik_flows.flowstagebinding
    id: {{ kind }}-binding-deny-reputation
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authenticator-{{ kind }}-setup]]
      stage: !KeyOf deny-reputation
      order: -20
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf {{ kind }}-binding-deny-reputation
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-reputation-ip]]
      order: 0
    attrs:
      failure_result: true
  - model: authentik_flows.flowstagebinding
    id: {{ kind }}-binding-password
    identifiers:
      target: !Find [authentik_flows.flow, [slug, default-authenticator-{{ kind }}-setup]]
      stage: !KeyOf password-check
      order: -10
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf {{ kind }}-binding-password
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-pending-user]]
      order: 0
{% endfor %}
