{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Authentication
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Password change
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Recovery
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Enrollment
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Authentication flow
      required: false
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Default - Password change flow
      required: false

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-authentication
    attrs:
      name: Authentication
      title: Neutrinet ID
      designation: authentication
      authentication: none

  - model: authentik_stages_identification.identificationstage
    id: identification
    identifiers:
      name: neutrinet-authentication-identification
    attrs:
      user_fields:
        - username
        - email
      pretend_user_exists: true
      show_matched_user: false
      enrollment_flow: !Find [authentik_flows.flow, [slug, neutrinet-enrollment]]
      recovery_flow: !Find [authentik_flows.flow, [slug, neutrinet-recovery]]
  - model: authentik_stages_password.passwordstage
    id: password
    identifiers:
      name: authentication-password-neutrinet
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      configure_flow: !Find [authentik_flows.flow, [slug, neutrinet-password-change]]
      failed_attempts_before_cancel: 5

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf identification
      order: 10
  - model: authentik_flows.flowstagebinding
    id: binding-deny-reputation
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-reputation]]
      order: 15
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf password
      order: 20
  - model: authentik_flows.flowstagebinding
    id: binding-deny-red-name
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-red-name]]
      order: 25
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_flows.flowstagebinding
    id: binding-mfa-privileged
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, neutrinet-mfa-privileged]]
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_flows.flowstagebinding
    id: binding-mfa
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, neutrinet-mfa]]
      order: 31
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_flows.flowstagebinding
    id: binding-login-privileged
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_user_login.userloginstage, [name, neutrinet-login-privileged]]
      order: 100
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  - model: authentik_flows.flowstagebinding
    id: binding-login
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_user_login.userloginstage, [name, neutrinet-login]]
      order: 101
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny-reputation
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-reputation-ip]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny-red-name
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-red-admin-only]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-mfa-privileged
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-privileged]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-mfa
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-not-privileged]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-login-privileged
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-privileged]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-login-privileged
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-user-path]]
      order: 10
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-login
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-not-privileged]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-login
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-user-path]]
      order: 10
  - model: authentik_policies.policybinding
    identifiers:
      target: !Find [authentik_policies.policybindingmodel, [flow__slug, default-authentication-flow]]
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-deny-all]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !Find [authentik_policies.policybindingmodel, [flow__slug, default-password-change]]
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-deny-all]]
      order: 0
