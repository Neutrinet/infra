{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Red invitation
entries:
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-write-email-only]]]
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_user_write.userwritestage, [name, neutrinet-write]]]
    attrs:
      identifiers:
        name: Neutrinet - Stages
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-enrollment-red
    attrs:
      name: Red invitation
      title: Create your administrator account
      designation: enrollment
      authentication: require_unauthenticated

  - model: authentik_stages_invitation.invitationstage
    id: invitation
    identifiers:
      name: neutrinet-enrollment-red-invitation
    attrs:
      continue_flow_without_invitation: false

  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-enrollment-red-write
    attrs:
      user_creation_mode: always_create
      create_users_as_inactive: true
      user_path_template: red-pending
      user_type: internal
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf invitation
      order: 10
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false
  - model: authentik_flows.flowstagebinding
    id: binding-deny
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-invitation]]
      order: 15
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-red-invitation]]
      order: 0

  - model: authentik_policies_expression.expressionpolicy
    id: notify-red-pending
    identifiers:
      name: neutrinet-notify-red-pending
    attrs:
      expression: |
        from authentik.core.models import User
        plan = request.context.get("flow_plan")
        if plan is None or plan.context.get("neutrinet_red_pending_notified"):
            return True
        plan.context["neutrinet_red_pending_notified"] = True
        user = request.user
        invite = request.context.get("invitation")
        inviter = invite.created_by.username if invite is not None and invite.created_by_id else ""
        recipients = User.objects.filter(groups__name="red", is_active=True).exclude(email="").exclude(pk=user.pk)
        subjects = {{ _authentik_i18n.mail_red_pending_subject | to_json }}
        for recipient in recipients:
            recipient_language = (recipient.locale() or "").replace("_", "-").split("-")[0].lower()
            if recipient_language not in {{ _authentik_languages | to_json }}:
                recipient_language = "en"
            ak_send_email(
                recipient.email,
                subjects[recipient_language],
                template="neutrinet/security_notice.html",
                context={"lang": recipient_language, "kind": "red_pending", "username": user.username, "address": user.email, "inviter": inviter},
            )
        return True
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    id: field-username-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-username-{{ lang }}
    attrs:
      field_key: username
      label: {{ _authentik_i18n.username[lang] | to_json }}
      type: username
      required: true
      placeholder: ""
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.username_red_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-email-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-email-{{ lang }}
    attrs:
      field_key: email
      label: {{ _authentik_i18n.email[lang] | to_json }}
      type: email
      required: true
      placeholder: ""
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.email_red_help[lang] | to_json }}
      order: 2
  - model: authentik_stages_prompt.prompt
    id: field-locale-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-locale-{{ lang }}
    attrs:
      field_key: attributes.settings.locale
      label: {{ _authentik_i18n.locale[lang] | to_json }}
      type: hidden
      required: false
      placeholder: {{ _authentik_locale_tags[lang] | to_json }}
      placeholder_expression: false
      order: 5
  - model: authentik_stages_prompt.promptstage
    id: prompt-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-username-{{ lang }}
        - !Find [authentik_stages_prompt.prompt, [name, neutrinet-field-name-{{ lang }}]]
        - !KeyOf field-email-{{ lang }}
        - !Find [authentik_stages_prompt.prompt, [name, neutrinet-field-password-{{ lang }}]]
        - !Find [authentik_stages_prompt.prompt, [name, neutrinet-field-password-repeat-{{ lang }}]]
        - !KeyOf field-locale-{{ lang }}
      validation_policies:
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-username-red]]
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-unique]]
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-length]]
        - !Find [authentik_policies_password.passwordpolicy, [name, neutrinet-password]]
  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt-{{ lang }}
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

  - model: authentik_stages_email.emailstage
    id: email-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-email-{{ lang }}
    attrs:
      use_global_settings: true
      subject: {{ _authentik_i18n.subject_enrollment_red[lang] | to_json }}
      template: neutrinet/{{ lang }}/account_confirmation.html
      token_expiry: hours=24
      activate_user_on_success: true
  - model: authentik_flows.flowstagebinding
    id: binding-email-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf email-{{ lang }}
      order: {{ 40 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

  - model: authentik_stages_prompt.prompt
    id: field-pending-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-pending-{{ lang }}
    attrs:
      field_key: neutrinet_red_pending
      label: Pending validation
      type: static
      required: false
      placeholder: ""
      placeholder_expression: false
      initial_value: {{ _authentik_i18n.red_pending_notice[lang] | to_json }}
      initial_value_expression: false
      order: 0
  - model: authentik_stages_prompt.promptstage
    id: pending-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-pending-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-pending-{{ lang }}
      validation_policies: []
  - model: authentik_flows.flowstagebinding
    id: binding-pending-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf pending-{{ lang }}
      order: {{ 50 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-pending-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-pending-{{ lang }}
      policy: !KeyOf notify-red-pending
      order: 10
{% endfor %}

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 30
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false
