{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Red invitation
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Groups
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Stages
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-enrollment-red
    attrs:
      name: Red invitation
      title: Create your administrator account
      designation: enrollment
      authentication: require_unauthenticated

  - model: authentik_stages_invitation.invitationstage
    id: invitation
    identifiers:
      name: neutrinet-enrollment-red-invitation
    attrs:
      continue_flow_without_invitation: false

  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-enrollment-red-write
    attrs:
      user_creation_mode: always_create
      create_users_as_inactive: true
      create_users_group: !Find [authentik_core.group, [name, red]]
      user_path_template: red
      user_type: internal
  - model: authentik_stages_password.passwordstage
    id: password
    identifiers:
      name: neutrinet-enrollment-red-password
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      failed_attempts_before_cancel: 5

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf invitation
      order: 10
  - model: authentik_flows.flowstagebinding
    id: binding-deny
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-invitation]]
      order: 15
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-red-invitation]]
      order: 0
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    id: field-username-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-username-{{ lang }}
    attrs:
      field_key: username
      label: {{ _authentik_i18n.username[lang] | to_json }}
      type: text_read_only
      required: false
      placeholder: {{ _authentik_i18n.username[lang] | to_json }}
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.username_red_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-name-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-name-{{ lang }}
    attrs:
      field_key: name
      label: {{ _authentik_i18n.name[lang] | to_json }}
      type: text
      required: true
      placeholder: {{ _authentik_i18n.name[lang] | to_json }}
      placeholder_expression: false
      order: 1
  - model: authentik_stages_prompt.prompt
    id: field-email-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-email-{{ lang }}
    attrs:
      field_key: email
      label: {{ _authentik_i18n.email[lang] | to_json }}
      type: text_read_only
      required: false
      placeholder: {{ _authentik_i18n.email[lang] | to_json }}
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.email_red_help[lang] | to_json }}
      order: 2
  - model: authentik_stages_prompt.prompt
    id: field-password-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-password-{{ lang }}
    attrs:
      field_key: password
      label: {{ _authentik_i18n.password[lang] | to_json }}
      type: password
      required: true
      placeholder: {{ _authentik_i18n.password[lang] | to_json }}
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.password_help[lang] | to_json }}
      order: 3
  - model: authentik_stages_prompt.prompt
    id: field-password-repeat-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-field-password-repeat-{{ lang }}
    attrs:
      field_key: password_repeat
      label: {{ _authentik_i18n.password_repeat[lang] | to_json }}
      type: password
      required: true
      placeholder: {{ _authentik_i18n.password_repeat[lang] | to_json }}
      placeholder_expression: false
      order: 4
  - model: authentik_stages_prompt.promptstage
    id: prompt-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-username-{{ lang }}
        - !KeyOf field-name-{{ lang }}
        - !KeyOf field-email-{{ lang }}
        - !KeyOf field-password-{{ lang }}
        - !KeyOf field-password-repeat-{{ lang }}
      validation_policies:
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-username-red]]
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-unique]]
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-length]]
        - !Find [authentik_policies_password.passwordpolicy, [name, neutrinet-password]]
  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt-{{ lang }}
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

  - model: authentik_stages_email.emailstage
    id: email-{{ lang }}
    identifiers:
      name: neutrinet-enrollment-red-email-{{ lang }}
    attrs:
      use_global_settings: true
      subject: {{ _authentik_i18n.subject_enrollment_red[lang] | to_json }}
      template: neutrinet/account_confirmation.html
      activate_user_on_success: true
  - model: authentik_flows.flowstagebinding
    id: binding-email-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf email-{{ lang }}
      order: {{ 40 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-flow-restored]]
      order: 1
{% endfor %}

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 30
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf password
      order: 45
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, neutrinet-mfa-privileged]]
      order: 50
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_user_login.userloginstage, [name, neutrinet-login-privileged]]
      order: 100
