{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Email change
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-email-change
    attrs:
      name: Email change
      title: Change your email address
      designation: stage_configuration
      authentication: require_authenticated

  - model: authentik_stages_password.passwordstage
    id: password
    identifiers:
      name: neutrinet-email-change-password
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      failed_attempts_before_cancel: 5
  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-email-change-write
    attrs:
      user_creation_mode: never_create

  - model: authentik_flows.flowstagebinding
    id: binding-password
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf password
      order: 10
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-password
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-pending-user]]
      order: 0
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    id: field-email-{{ lang }}
    identifiers:
      name: neutrinet-email-change-field-email-{{ lang }}
    attrs:
      field_key: email
      label: {{ _authentik_i18n.new_email[lang] | to_json }}
      type: email
      required: true
      placeholder: {{ _authentik_i18n.new_email[lang] | to_json }}
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.new_email_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.promptstage
    id: prompt-{{ lang }}
    identifiers:
      name: neutrinet-email-change-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-email-{{ lang }}
      validation_policies:
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-different]]
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-unique]]
  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt-{{ lang }}
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

  - model: authentik_stages_email.emailstage
    id: email-{{ lang }}
    identifiers:
      name: neutrinet-email-change-email-{{ lang }}
    attrs:
      use_global_settings: true
      subject: {{ _authentik_i18n.subject_email_change[lang] | to_json }}
      template: neutrinet/email_change.html
      activate_user_on_success: false
  - model: authentik_flows.flowstagebinding
    id: binding-email-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf email-{{ lang }}
      order: {{ 30 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-changed]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 10
{% endfor %}

  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 40
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-verified]]
      order: 0
