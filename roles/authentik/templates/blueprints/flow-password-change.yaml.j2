{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Password change
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-password-change
    attrs:
      name: Password change
      title: Change your password
      designation: stage_configuration
      authentication: require_authenticated

  - model: authentik_stages_password.passwordstage
    id: current-password
    identifiers:
      name: neutrinet-password-change-current
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      failed_attempts_before_cancel: 5

  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-password-change-write
    attrs:
      user_creation_mode: never_create

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf current-password
      order: 10
{% for lang in _authentik_languages %}

  - model: authentik_stages_prompt.prompt
    id: field-password-{{ lang }}
    identifiers:
      name: neutrinet-password-change-field-password-{{ lang }}
    attrs:
      field_key: password
      label: {{ _authentik_i18n.new_password[lang] | to_json }}
      type: password
      required: true
      placeholder: {{ _authentik_i18n.new_password[lang] | to_json }}
      placeholder_expression: false
      sub_text: {{ _authentik_i18n.password_help[lang] | to_json }}
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-password-repeat-{{ lang }}
    identifiers:
      name: neutrinet-password-change-field-password-repeat-{{ lang }}
    attrs:
      field_key: password_repeat
      label: {{ _authentik_i18n.new_password_repeat[lang] | to_json }}
      type: password
      required: true
      placeholder: {{ _authentik_i18n.new_password_repeat[lang] | to_json }}
      placeholder_expression: false
      order: 1
  - model: authentik_stages_prompt.promptstage
    id: prompt-{{ lang }}
    identifiers:
      name: neutrinet-password-change-prompt-{{ lang }}
    attrs:
      fields:
        - !KeyOf field-password-{{ lang }}
        - !KeyOf field-password-repeat-{{ lang }}
      validation_policies:
        - !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-length]]
        - !Find [authentik_policies_password.passwordpolicy, [name, neutrinet-password]]
  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt-{{ lang }}
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0
{% endfor %}

  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]
      order: 0
