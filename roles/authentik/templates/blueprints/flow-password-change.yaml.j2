{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Changement de mot de passe
entries:
  - model: authentik_blueprints.metaapplyblueprint
    attrs:
      identifiers:
        name: Neutrinet - Politiques
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-password-change
    attrs:
      name: Changement de mot de passe
      title: Changer ton mot de passe
      designation: stage_configuration
      authentication: require_authenticated

  - model: authentik_stages_password.passwordstage
    id: current-password
    identifiers:
      name: neutrinet-password-change-current
    attrs:
      backends:
        - authentik.core.auth.InbuiltBackend
      failed_attempts_before_cancel: 5

  - model: authentik_stages_prompt.prompt
    id: field-password
    identifiers:
      name: neutrinet-password-change-field-password
    attrs:
      field_key: password
      label: Nouveau mot de passe
      type: password
      required: true
      placeholder: Nouveau mot de passe
      placeholder_expression: false
      order: 0
  - model: authentik_stages_prompt.prompt
    id: field-password-repeat
    identifiers:
      name: neutrinet-password-change-field-password-repeat
    attrs:
      field_key: password_repeat
      label: Nouveau mot de passe (confirmation)
      type: password
      required: true
      placeholder: Nouveau mot de passe (confirmation)
      placeholder_expression: false
      order: 1
  - model: authentik_stages_prompt.promptstage
    id: prompt
    identifiers:
      name: neutrinet-password-change-prompt
    attrs:
      fields:
        - !KeyOf field-password
        - !KeyOf field-password-repeat
      validation_policies:
        - !Find [authentik_policies_password.passwordpolicy, [name, neutrinet-password]]

  - model: authentik_stages_user_write.userwritestage
    id: write
    identifiers:
      name: neutrinet-password-change-write
    attrs:
      user_creation_mode: never_create

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf current-password
      order: 10
  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf prompt
      order: 20
  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf write
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]
      order: 0
