{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Password change
entries:
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]]
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_user_write.userwritestage, [name, neutrinet-write]]]
    attrs:
      identifiers:
        name: Neutrinet - Stages
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-password-change
    attrs:
      name: Password change
      title: Change your password
      designation: stage_configuration
      authentication: require_authenticated

  - model: authentik_flows.flowstagebinding
    id: binding-deny-reputation
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-reputation]]
      order: 5
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny-reputation
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-reputation-ip]]
      order: 0
    attrs:
      failure_result: true

  - model: authentik_flows.flowstagebinding
    id: binding-current-password
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_password.passwordstage, [name, neutrinet-password-check]]
      order: 10
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-current-password
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-pending-user]]
      order: 0
{% for lang in _authentik_languages %}

  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_prompt.promptstage, [name, neutrinet-new-password-prompt-{{ lang }}]]
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0
{% endfor %}

  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_user_write.userwritestage, [name, neutrinet-write]]
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]
      order: 0
