{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Recovery
entries:
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-unchanged]]]
    attrs:
      identifiers:
        name: Neutrinet - Policies
      required: true
  - model: authentik_blueprints.metaapplyblueprint
    conditions:
      - !Condition [NOR, !Find [authentik_stages_user_write.userwritestage, [name, neutrinet-write]]]
    attrs:
      identifiers:
        name: Neutrinet - Stages
      required: true

  - model: authentik_flows.flow
    id: flow
    identifiers:
      slug: neutrinet-recovery
    attrs:
      name: Password recovery
      title: Reset your password
      designation: recovery
      authentication: require_unauthenticated

  - model: authentik_stages_identification.identificationstage
    id: identification
    identifiers:
      name: neutrinet-recovery-identification
    attrs:
      user_fields:
        - username
        - email
      pretend_user_exists: true
      show_matched_user: false

  - model: authentik_flows.flowstagebinding
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf identification
      order: 10
    attrs:
      evaluate_on_plan: true
      re_evaluate_policies: false

  - model: authentik_flows.flowstagebinding
    id: binding-deny-email-link
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_deny.denystage, [name, neutrinet-deny-email-link]]
      order: 25
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-deny-email-link
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-email-link-missing]]
      order: 0
    attrs:
      failure_result: true

  - model: authentik_flows.flowstagebinding
    id: binding-mfa-privileged
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, neutrinet-mfa-recovery-privileged]]
      order: 30
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-mfa-privileged
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-privileged]]
      order: 0
    attrs:
      failure_result: true
  - model: authentik_flows.flowstagebinding
    id: binding-mfa
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_authenticator_validate.authenticatorvalidatestage, [name, neutrinet-mfa]]
      order: 31
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-mfa
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-is-not-privileged]]
      order: 0
{% for lang in _authentik_languages %}

  - model: authentik_stages_email.emailstage
    id: email-{{ lang }}
    identifiers:
      name: neutrinet-recovery-email-{{ lang }}
    attrs:
      use_global_settings: true
      subject: {{ _authentik_i18n.subject_recovery[lang] | to_json }}
      template: neutrinet/{{ lang }}/password_reset.html
      token_expiry: minutes=30
      activate_user_on_success: true
  - model: authentik_flows.flowstagebinding
    id: binding-email-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !KeyOf email-{{ lang }}
      order: {{ 20 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-email-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0

  - model: authentik_flows.flowstagebinding
    id: binding-prompt-{{ lang }}
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_prompt.promptstage, [name, neutrinet-new-password-prompt-{{ lang }}]]
      order: {{ 40 + loop.index0 }}
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-prompt-{{ lang }}
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-language-{{ lang }}]]
      order: 0
{% endfor %}

  - model: authentik_flows.flowstagebinding
    id: binding-write
    identifiers:
      target: !KeyOf flow
      stage: !Find [authentik_stages_user_write.userwritestage, [name, neutrinet-write]]
      order: 50
    attrs:
      evaluate_on_plan: false
      re_evaluate_policies: true
      policy_engine_mode: all
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-terminate-sessions]]
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-write-password-only]]
      order: 10
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-reputation-reset]]
      order: 20
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf binding-write
      policy: !Find [authentik_policies_expression.expressionpolicy, [name, neutrinet-password-unchanged]]
      order: 30
