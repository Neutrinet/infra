{{ ansible_managed | comment }}
version: 1
metadata:
  name: Neutrinet - Notifications
entries:

  - model: authentik_policies_expression.expressionpolicy
    id: notify-security-policy
    identifiers:
      name: neutrinet-notify-security
    attrs:
      expression: |
        from authentik.core.models import User
        event = request.context["event"]
        user = request.user
        devices = (
            "authentik_stages_authenticator_webauthn.webauthndevice",
            "authentik_stages_authenticator_totp.totpdevice",
            "authentik_stages_authenticator_static.staticdevice",
        )
        model = event.context.get("model", {})
        model_name = f"{model.get('app')}.{model.get('model_name')}"
        if event.action == "login":
            kind = "breakglass_login"
        elif event.action == "password_set":
            kind = "password_set"
        elif event.action == "model_created" and model_name in devices:
            kind = "device_added"
        elif event.action == "model_deleted" and model_name in devices:
            kind = "device_removed"
        else:
            return False
        if kind == "breakglass_login":
            if not ak_is_group_member(user, name="authentik Admins"):
                return False
            recipients = User.objects.filter(groups__name="red", is_active=True).exclude(email="").exclude(pk=user.pk)
        elif getattr(user, "email", ""):
            recipients = [user]
        else:
            return False
        subjects = {
            "breakglass_login": {{ _authentik_i18n.mail_breakglass_subject | to_json }},
            "password_set": {{ _authentik_i18n.mail_password_set_subject | to_json }},
            "device_added": {{ _authentik_i18n.mail_device_added_subject | to_json }},
            "device_removed": {{ _authentik_i18n.mail_device_removed_subject | to_json }},
        }
        for recipient in recipients:
            recipient_language = (recipient.locale() or "").replace("_", "-").split("-")[0].lower()
            if recipient_language not in {{ _authentik_languages | to_json }}:
                recipient_language = "en"
            ak_send_email(
                recipient.email,
                subjects[kind][recipient_language],
                template="neutrinet/security_notice.html",
                context={"lang": recipient_language, "kind": kind, "username": user.username, "ip": event.client_ip},
            )
        return False

  - model: authentik_events.notificationrule
    id: notify-security
    identifiers:
      name: neutrinet-notify-security
    attrs:
      severity: warning
      destination_event_user: false
      transports: []

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf notify-security
      policy: !KeyOf notify-security-policy
      order: 0
